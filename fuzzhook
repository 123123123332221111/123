----------------------------------------------------------------------
-- UI OPACITY STATE
-- One shared opacity value for every panel AND the notification boxes.
--   * boxes use the "UI Opacity" slider value, text / dots use it + 0.1
-- NOTE: Drawing.Transparency is assumed to be 1 = solid, 0 = invisible
-- (Roblox convention). If the slider behaves backwards, change bgAlpha() and
-- fgAlpha() below to return 1 - value.
----------------------------------------------------------------------
local uiOpacity = DEFAULT_OPACITY

local function bgAlpha()
    return uiOpacity
end

local function fgAlpha()
    local v = uiOpacity + 0.1
    return (v > 1) and 1 or v
end

----------------------------------------------------------------------
-- NOTIFICATION BOX (reusable)
-- Bottom-right box drawn with the Drawing API, stacks upward. Same look as the
-- panels (rounded box, colored dot + title, separator, gray text) and it follows
-- the UI Opacity slider. Not draggable.
-- Use it for anything:
--   Notification.push("Title", "Message")
--   Notification.push("Title", "Message", { seconds = 15, color = Color3.fromRGB(255,160,0) })
-- "color" is the color of the dot next to the title.
----------------------------------------------------------------------
local Notification = {}
do
    -- Every notification is animated by ONE RenderStepped callback (below). When no
    -- notification is on screen that callback returns immediately, so it costs nothing.
    -- Life of a notification: slide in from the right (SLIDE_TIME) -> stays for
    -- "seconds" with a countdown next to the title -> slides back out to the right.
    -- Positions are only rewritten while it is sliding; while it rests, the only
    -- work is updating the countdown text once per second.
    local active = {}  -- [drawing] = true for box drawings, false for text / dots (used by refreshOpacity)
    local slots = {}
    local notes = {}   -- notifications currently on screen
    local DEFAULT_COLOR = Color3.fromRGB(255, 80, 80)
    local BG_COLOR = Color3.fromRGB(22, 22, 28)
    local TITLE_COLOR = Color3.fromRGB(255, 255, 255)
    local TEXT_COLOR = Color3.fromRGB(190, 190, 200)
    local LINE_COLOR = Color3.fromRGB(80, 80, 92)
    local W, H = 260, 58
    local SLIDE_TIME = 0.35     -- seconds for the slide in / slide out
    local OFFSCREEN = W + 40    -- how far right of its resting spot it starts / ends

    -- Re-applies the UI Opacity slider to every notification that is on screen
    function Notification.refreshOpacity()
        local bgA, fgA = bgAlpha(), fgAlpha()
        for d, isBg in pairs(active) do
            pcall(function() d.Transparency = isBg and bgA or fgA end)
        end
    end

    -- Moves every drawing of a notification to its resting spot + offset (px to the right)
    local function setOffset(n, offset)
        local x = n.baseX + offset
        local y = n.y
        local items = n.items
        for i = 1, #items do
            local it = items[i]
            it.d.Position = Vector2.new(x + it.ox, y + it.oy)
        end
    end

    local function destroyNote(n)
        local items = n.items
        for i = 1, #items do
            local d = items[i].d
            active[d] = nil
            pcall(function() d:Remove() end)
        end
        slots[n.slot] = nil
    end

    -- Title text is "<title> (<seconds left>)"; only written when the number changes
    local function setTimer(n, secs)
        if n.timer ~= secs then
            n.timer = secs
            n.titleD.Text = n.title .. " (" .. secs .. ")"
        end
    end

    local function make(n, class, props, ox, oy, isBg)
        local d = Drawing.new(class)
        n.items[#n.items + 1] = { d = d, ox = ox, oy = oy }
        for k, v in pairs(props) do
            d[k] = v
        end
        if class == "Text" then d.Outline = false end -- no stroke on text
        d.Transparency = isBg and bgAlpha() or fgAlpha()
        active[d] = isBg or false
        d.Position = Vector2.new(n.baseX + OFFSCREEN + ox, n.y + oy) -- starts off screen
        return d
    end

    function Notification.push(title, message, opts)
        opts = opts or {}
        local seconds = opts.seconds or 10
        local accent = opts.color or DEFAULT_COLOR
        local secs = math.ceil(seconds)

        local slot = 1
        while slots[slot] do slot = slot + 1 end
        slots[slot] = true

        local n = { slot = slot, title = title, seconds = seconds, items = {}, timer = secs, settled = false }

        local built = pcall(function()
            local view = Workspace.CurrentCamera.ViewportSize
            n.baseX = view.X - W - 20
            n.y = view.Y - (H + 10) * slot - 10

            local bg = make(n, "Square", {
                Filled = true, Color = BG_COLOR,
                Size = Vector2.new(W, H), ZIndex = 10, Visible = true,
            }, 0, 0, true)
            pcall(function() bg.Corner = 8 end) -- rounded corners if supported

            make(n, "Square", { -- colored dot next to the title
                Filled = true, Color = accent,
                Size = Vector2.new(6, 6), ZIndex = 11, Visible = true,
            }, 12, 12, false)
            n.titleD = make(n, "Text", {
                Text = title .. " (" .. secs .. ")", Color = TITLE_COLOR,
                Font = Drawing.Fonts.SystemBold, Size = 12,
                ZIndex = 11, Visible = true,
            }, 24, 8, false)
            make(n, "Square", { -- separator line
                Filled = true, Color = LINE_COLOR,
                Size = Vector2.new(W - 24, 1), ZIndex = 11, Visible = true,
            }, 12, 27, false)
            make(n, "Text", {
                Text = message, Color = TEXT_COLOR,
                Font = Drawing.Fonts.System, Size = 13,
                ZIndex = 11, Visible = true,
            }, 12, 35, false)
        end)

        if built then
            n.t0 = tick()
            notes[#notes + 1] = n
        else
            loadErrors = loadErrors + 1
            destroyNote(n) -- removes anything half-built and frees the slot
            -- the box could not be drawn: fall back to Matcha's own notification
            pcall(function() notify(message, title, seconds) end)
        end
    end

    local function noteStep()
        if #notes == 0 then return end -- nothing on screen: no work at all
        local now = tick()
        local i = 1
        while i <= #notes do
            local n = notes[i]
            local age = now - n.t0
            local holdEnd = SLIDE_TIME + n.seconds

            if age < SLIDE_TIME then
                -- slide in (ease-out: fast at first, settles gently)
                local inv = 1 - age / SLIDE_TIME
                setOffset(n, OFFSCREEN * inv * inv * inv)
                i = i + 1
            elseif age < holdEnd then
                -- resting: snap into place once, then only the countdown text changes
                if not n.settled then
                    n.settled = true
                    setOffset(n, 0)
                end
                setTimer(n, math.ceil(holdEnd - age))
                i = i + 1
            elseif age < holdEnd + SLIDE_TIME then
                -- slide out to the right (ease-in: starts gently, speeds up)
                local t = (age - holdEnd) / SLIDE_TIME
                setOffset(n, OFFSCREEN * t * t * t)
                setTimer(n, 0)
                i = i + 1
            else
                destroyNote(n)
                table.remove(notes, i)
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        guarded(noteStep)
    end)
end

