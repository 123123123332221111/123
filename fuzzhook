----------------------------------------------------------------------
-- Cached lookups
----------------------------------------------------------------------
local playersFolder -- ReplicatedStorage.Players, cached after first find

local function getPlayersFolder()
    if not playersFolder or playersFolder.Parent == nil then
        playersFolder = ReplicatedStorage:FindFirstChild("Players")
    end
    return playersFolder
end

-- ReplicatedStorage.Players.<name>.Status.Purchases.Passes (no temp tables)
local function getPasses(folder, name)
    local n = folder:FindFirstChild(name)
    n = n and n:FindFirstChild("Status")
    n = n and n:FindFirstChild("Purchases")
    return n and n:FindFirstChild("Passes")
end

-- Reports: ReplicatedStorage.Players.<you>.Status.UAC.Reports (count is attribute "1")
-- Looked up fresh on every read so the attribute value is never stale
-- (4 cheap lookups every 0.5s).
local function readReports()
    local folder = getPlayersFolder()
    local n = folder and folder:FindFirstChild(LOCAL_NAME)
    n = n and n:FindFirstChild("Status")
    n = n and n:FindFirstChild("UAC")
    n = n and n:FindFirstChild("Reports")
    if not n then return nil end

    local attr = n:GetAttribute("1")
    if type(attr) == "number" then return attr end
    return n.Value
end

local function isOn(v)
    return v == true or v == 1
end

local function findStaffTag(passes)
    for i = 1, #STAFF_TAGS do
        local tag = STAFF_TAGS[i]
        if isOn(passes:GetAttribute(tag)) then
            return tag
        end
    end
    return nil
end

----------------------------------------------------------------------
-- Staff scan: everyone CURRENTLY in game.Players, single pass
----------------------------------------------------------------------
local function scanServer()
    local folder = getPlayersFolder()
    if not folder then
        scanLines = { "ReplicatedStorage.Players not found" }
        setStaffText("None")
        modTargets = {}
        return
    end

    local current = Players:GetPlayers()
    local lines = { "Players in server: " .. #current }
    local found, newMods, present = {}, {}, {}

    for _, plr in ipairs(current) do
        local name = plr.Name
        present[name] = true
        local isMe = (name == LOCAL_NAME)
        local who = isMe and (name .. " (you)") or name
        local passes = getPasses(folder, name)

        if not passes then
            lines[#lines + 1] = who .. ": no Passes found"
        else
            local tag = findStaffTag(passes)
            if tag then
                lines[#lines + 1] = who .. " -> " .. tag
                found[#found + 1] = who .. " (" .. tag .. ")"

                -- label + notification apply to other players only (you are in the list for testing)
                if not isMe then
                    newMods[name] = true
                    if not alertedStaff[name] then
                        alertedStaff[name] = true
                        Notification.push("Staff Detector", name .. " has " .. tag, STAFF_NOTIFY)
                        warn("[Staff Detector] " .. name .. " has " .. tag)
                    end
                end
            else
                lines[#lines + 1] = who .. ": none"
            end
        end
    end

    -- forget players who left so they alert again if they rejoin
    for name in pairs(alertedStaff) do
        if not present[name] then alertedStaff[name] = nil end
    end

    scanLines = lines
    setStaffText((#found > 0) and table.concat(found, ", ") or "None")
    modTargets = newMods
end

----------------------------------------------------------------------
-- Single scheduler loop (nothing runs for a feature while it is off)
----------------------------------------------------------------------
local lastReports -- nil while Report Alert is off; baseline count while on
local wasStaffOn = false
local ticks = 0

task.spawn(function()
    while true do
        ticks = ticks + 1

        -- Report Count label (always) + Report Alert (toggle)
        local ok, count = pcall(readReports)
        if ok and type(count) == "number" then
            setReportText(tostring(count))

            if UI.GetValue("opt_two") then
                if lastReports == nil then
                    lastReports = count -- baseline when the toggle is switched on
                elseif count > lastReports then
                    local diff = count - lastReports
                    lastReports = count
                    Notification.push(
                        "Report Alert",
                        "You were reported! Total: " .. count .. " (+" .. diff .. ")",
                        REPORT_NOTIFY
                    )
                    warn("[Report Alert] Reports = " .. count .. " (+" .. diff .. ")")
                elseif count < lastReports then
                    lastReports = count -- count was reset/lowered
                end
            else
                lastReports = nil
            end
        else
            setReportText("N/A")
        end

        -- Staff Detector (toggle): scan immediately when turned on, then every 2s
        local staffOn = UI.GetValue("opt_one")
        if staffOn then
            if not wasStaffOn or ticks % STAFF_SCAN_EVERY == 0 then
                local sok, err = pcall(scanServer)
                if not sok then
                    scanLines = { "Scan error: " .. tostring(err) }
                end
            end
        elseif wasStaffOn then
            -- only reset once, right after turning the toggle off
            setStaffText("None")
            scanLines = { "Turn on Staff Detector to scan" }
            modTargets = {}
            alertedStaff = {}
        end
        wasStaffOn = staffOn

        wait(TICK_SECONDS)
    end
end)

----------------------------------------------------------------------
-- [POSSIBLE MOD] labels drawn over detected players
----------------------------------------------------------------------
local modLabels = {}        -- [playerName] = { d = Drawing, plr = Player, part = BasePart, vis = bool }
local labelsBroken = false  -- stop retrying if Drawing rejects a property

local function makeModLabel()
    local d = Drawing.new("Text")
    local ok = pcall(function()
        d.Text = "[POSSIBLE MOD]"
        d.Color = Color3.fromRGB(255, 0, 0)
        d.Font = Drawing.Fonts.SystemBold
        d.Size = 12
        d.Center = true
        d.Outline = true
        d.Visible = false
    end)
    if not ok then
        pcall(function() d:Remove() end)
        return nil
    end
    return d
end

-- RenderStepped = once per rendered frame (smoother for overlays than Heartbeat)
RunService.RenderStepped:Connect(function()
    if labelsBroken then return end
    -- nothing detected and nothing drawn -> no work at all
    if next(modTargets) == nil and next(modLabels) == nil then return end

    -- remove labels for players who are no longer detected / left
    for name, e in pairs(modLabels) do
        if not modTargets[name] then
            pcall(function() e.d:Remove() end)
            modLabels[name] = nil
        end
    end

    for name in pairs(modTargets) do
        local e = modLabels[name]
        if not e then
            local d = makeModLabel()
            if not d then
                labelsBroken = true
                warn("[POSSIBLE MOD] could not create label")
                return
            end
            e = { d = d, vis = false }
            modLabels[name] = e
        end

        -- cached part; only re-resolved when it disappears (respawn / leave)
        local part = e.part
        if not part or part.Parent == nil then
            local plr = e.plr
            if not plr or plr.Parent == nil then
                plr = Players:FindFirstChild(name)
                e.plr = plr
            end
            local char = plr and plr.Character
            part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
            e.part = part
        end

        local d = e.d
        if part then
            local pos, onScreen = WorldToScreen(part.Position + LABEL_OFFSET)
            if onScreen then
                d.Position = Vector2.new(pos.X, pos.Y - 7)
                if not e.vis then d.Visible = true; e.vis = true end
            elseif e.vis then
                d.Visible = false; e.vis = false
            end
        elseif e.vis then
            d.Visible = false; e.vis = false
        end
    end
end)

