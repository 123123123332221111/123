-- The Hotbar folder is cached per target (re-found when the target changes or it disappears)
local hbFolderName, hbFolder

-- Reads the 7 slots into out[1..7] ("" = empty / not a listed item)
-- Returns false if the Hotbar folder could not be found.
local function readHotbar(name, out)
    if hbFolderName ~= name or not hbFolder or hbFolder.Parent == nil then
        local folder = getPlayersFolder()
        local n = folder and folder:FindFirstChild(name)
        n = n and n:FindFirstChild("Status")
        n = n and n:FindFirstChild("GameplayVariables")
        n = n and n:FindFirstChild("Hotbar")
        hbFolder = n
        hbFolderName = name
    end
    local n = hbFolder

    for i = 1, HB_COUNT do
        local item = ""
        local slot = n and n:FindFirstChild(HOTBAR_SLOTS[i])
        local v = slot and slot.Value
        if v ~= nil then
            local itemName
            if type(v) == "string" then
                itemName = string.match(v, "([^%.]+)$") -- value stored as a path string
            else
                itemName = v.Name                       -- ObjectValue -> the item itself
            end
            if itemName and ITEM_CATEGORIES[itemName] then
                item = itemName
            end
        end
        out[i] = item
    end
    return n ~= nil
end

local hbTarget, hbLastRead = nil, 0
local hbRead = {}

local function hotbarStep(target, now)
    if target then
        if target ~= hbTarget or now - hbLastRead >= HOTBAR_REFRESH then
            hbTarget = target
            hbLastRead = now
            local found = readHotbar(target, hbRead)
            local title = found and ("Hotbar - " .. target) or ("Hotbar - " .. target .. " (not found)")
            if title ~= hbTitleText then
                hbTitleText = title
                hbTitle.Text = title
            end
            for i = 1, HB_COUNT do setSlotItem(i, hbRead[i]) end
        end
        showHotbar(true)
    else
        hbTarget = nil
        showHotbar(false)
    end
end

----------------------------------------------------------------------
-- Shared step: one "looked-at player" pick feeds all panels
-- Returns true while any of Player Info / Inv Aim / Hotbar is on, so the loop
-- can sleep longer when nothing is active.
----------------------------------------------------------------------
local infoTarget, infoLastRead = nil, 0
local invTarget, invLastRead = nil, 0
local invPending -- target seen once; Inv Aim only scans after it is stable for a second tick

local function infoStep()
    local wantInfo = panelOK and UI.GetValue("opt_info")
    local wantInv = invOK and UI.GetValue("opt_inv")
    local wantHotbar = hbOK and UI.GetValue("opt_hotbar")
    local hbSelf = UI.GetValue("hotbar_target") == 1

    local now = tick()
    local needLook = wantInfo or wantInv or (wantHotbar and not hbSelf)
    local target = needLook and findLookedAtPlayer(now) or nil

    -- Player Info (re-read only when the target changes or every INFO_REFRESH seconds)
    if wantInfo and target then
        if target ~= infoTarget or now - infoLastRead >= INFO_REFRESH then
            infoTarget = target
            infoLastRead = now
            local reportsStr, playStr = readPlayerInfo(target)
            updateInfoPanel(target, reportsStr, playStr)
        end
        showInfoPanel(true)
    else
        infoTarget = nil
        showInfoPanel(false)
    end

    -- Inv Aim (debounced: sweeping the crosshair across players doesn't scan every one)
    if wantInv and target then
        if target ~= invTarget then
            if invPending ~= target then
                invPending = target -- first sighting, wait one more tick
            else
                invPending = nil
                invTarget = target
                invLastRead = now
                updateInvPanel(target)
            end
        elseif now - invLastRead >= INFO_REFRESH then
            invLastRead = now
            updateInvPanel(target)
        end
        showInvPanel(invTarget ~= nil)
    else
        invPending = nil
        invTarget = nil
        showInvPanel(false)
    end

    -- Hotbar (looked-at player, or yourself)
    if wantHotbar then
        hotbarStep(hbSelf and LOCAL_NAME or target, now)
    else
        hotbarStep(nil, now)
    end

    return (wantInfo or wantInv or wantHotbar) and true or false
end

task.spawn(function()
    while true do
        local ok, active = pcall(infoStep)
        if not ok then
            loadErrors = loadErrors + 1
            if not warnedOnce then
                warnedOnce = true
                warn("FurryHook error:", active)
            end
        end
        wait(active == true and INFO_SELECT_EVERY or INFO_IDLE_EVERY)
    end
end)

-- report this block's load state to the final check
