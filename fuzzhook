----------------------------------------------------------------------
-- Cached lookups
----------------------------------------------------------------------
local playersFolder -- ReplicatedStorage.Players, cached after first find

local function getPlayersFolder()
    if not playersFolder or playersFolder.Parent == nil then
        playersFolder = ReplicatedStorage:FindFirstChild("Players")
    end
    return playersFolder
end

-- ReplicatedStorage.Players.<name>.Status.Purchases.Passes (no temp tables)
local function getPasses(folder, name)
    local n = folder:FindFirstChild(name)
    n = n and n:FindFirstChild("Status")
    n = n and n:FindFirstChild("Purchases")
    return n and n:FindFirstChild("Passes")
end

-- Reports: ReplicatedStorage.Players.<you>.Status.UAC.Reports (count is attribute "1")
-- Looked up fresh on every read so the attribute value is never stale
-- (4 cheap lookups every 0.5s).
local function readReports()
    local folder = getPlayersFolder()
    local n = folder and folder:FindFirstChild(LOCAL_NAME)
    n = n and n:FindFirstChild("Status")
    n = n and n:FindFirstChild("UAC")
    n = n and n:FindFirstChild("Reports")
    if not n then return nil end

    local attr = n:GetAttribute("1")
    if type(attr) == "number" then return attr end
    return n.Value
end

local function isOn(v)
    return v == true or v == 1
end

-- A Bool can be stored as an attribute or as a BoolValue child; check both.
local function readFlag(inst, name)
    if isOn(inst:GetAttribute(name)) then return true end
    local child = inst:FindFirstChild(name)
    if child and isOn(child.Value) then return true end
    return false
end

-- plrFolder = ReplicatedStorage.Players.<name>, passes = its Status.Purchases.Passes (may be nil)
local function isEarlyAccess(plrFolder, passes)
    if readFlag(plrFolder, "EarlyAccessUser") then return true end
    if passes and readFlag(passes, "GivenEarlyAccess") then return true end -- failsafe
    return false
end

----------------------------------------------------------------------
-- PANEL SYSTEM (shared by Player Info, Inv Aim, Hotbar, Staff List)
-- Every drawing in a panel is registered with an offset from the panel's
-- origin, so moving a panel = rewriting each drawing's Position once.
--   * bg drawings use the UI Opacity value, text uses it + 0.1
--   * panel.bottom = true means panel.y is the BOTTOM edge (panel grows upward)
-- NOTE: Drawing.Transparency is assumed to be 1 = solid, 0 = invisible
-- (Roblox convention). If the slider behaves backwards, change bgAlpha() and
-- fgAlpha() below to return 1 - value.
----------------------------------------------------------------------
local panels = {}

local function newPanel(id, x, y, w, h, bottom)
    local p = {
        id = id,
        x = x, y = y,       -- current position (top-left, or bottom-left if p.bottom)
        dx = x, dy = y,     -- default position (for "Reset UI Positions")
        w = w, h = h,
        bottom = bottom or false,
        items = {},         -- { d = Drawing, ox = number, oy = number, bg = bool }
        shown = false,
    }
    panels[#panels + 1] = p
    return p
end

local function panelTop(p)
    if p.bottom then return p.y - p.h end
    return p.y
end

-- Writes every drawing's Position from the panel origin (only called on move / re-layout)
local function placePanel(p)
    local top = panelTop(p)
    local items = p.items
    for i = 1, #items do
        local it = items[i]
        it.d.Position = Vector2.new(p.x + it.ox, top + it.oy)
    end
end

-- Creates a drawing inside a panel. props must NOT contain Position (use ox / oy).
local function addItem(p, class, props, ox, oy, isBg)
    local d = Drawing.new(class)
    p.items[#p.items + 1] = { d = d, ox = ox, oy = oy, bg = isBg or false }
    for k, v in pairs(props) do
        d[k] = v
    end
    if class == "Text" then d.Outline = false end -- no stroke on text
    d.Transparency = isBg and bgAlpha() or fgAlpha()
    d.Position = Vector2.new(p.x + ox, panelTop(p) + oy)
    return d
end

local function destroyPanel(p)
    for i = 1, #p.items do
        local d = p.items[i].d
        pcall(function() d:Remove() end)
    end
    p.items = {}
    p.shown = false
end

local function setPanelItemsVisible(p, v)
    local items = p.items
    for i = 1, #items do
        items[i].d.Visible = v
    end
    p.shown = v
end

local function applyOpacity()
    Notification.refreshOpacity()
    local bgA, fgA = bgAlpha(), fgAlpha()
    for i = 1, #panels do
        local items = panels[i].items
        for j = 1, #items do
            local it = items[j]
            it.d.Transparency = it.bg and bgA or fgA
        end
    end
end

local function clamp(v, lo, hi)
    if hi < lo then return lo end
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

resetPanels = function()
    for i = 1, #panels do
        local p = panels[i]
        p.x, p.y = p.dx, p.dy
        placePanel(p)
    end
end

----------------------------------------------------------------------
-- Report loop (Report Count label always, Report Alert while its toggle is on)
----------------------------------------------------------------------
local lastReports -- nil while Report Alert is off; baseline count while on

task.spawn(function()
    while true do
        -- Report Count label (always) + Report Alert (toggle)
        local ok, count = pcall(readReports)
        if not ok then loadErrors = loadErrors + 1 end

        if ok and type(count) == "number" then
            setReportText(tostring(count))

            if UI.GetValue("opt_two") then
                if lastReports == nil then
                    lastReports = count -- baseline when the toggle is switched on
                elseif count > lastReports then
                    local diff = count - lastReports
                    lastReports = count
                    Notification.push(
                        "Report Alert",
                        "You were reported! Total: " .. count .. " (+" .. diff .. ")",
                        REPORT_NOTIFY
                    )
                elseif count < lastReports then
                    lastReports = count -- count was reset/lowered
                end
            else
                lastReports = nil
            end
        else
            setReportText("N/A")
        end

        wait(TICK_SECONDS)
    end
end)

----------------------------------------------------------------------
-- [POSSIBLE MOD] / "God Moded" labels drawn over detected players
-- (world overlay, not a panel: left opaque and not draggable)
-- modTargets[name] == true  -> red "[POSSIBLE MOD]"
-- modTargets[name] == "god" -> orange "God Moded"
----------------------------------------------------------------------
local modLabels = {}        -- [playerName] = { d = Drawing, plr = Player, part = BasePart, vis = bool, mode = true | "god" }
local labelsBroken = false  -- stop retrying if Drawing rejects a property

local function makeModLabel()
    local d = Drawing.new("Text")
    local ok = pcall(function()
        d.Text = "[POSSIBLE MOD]"
        d.Color = Color3.fromRGB(255, 0, 0)
        d.Font = Drawing.Fonts.SystemBold
        d.Size = 12
        d.Center = true
        d.Outline = false
        d.Visible = false
    end)
    if not ok then
        pcall(function() d:Remove() end)
        return nil
    end
    return d
end

-- RenderStepped = once per rendered frame (smoother for overlays than Heartbeat)
RunService.RenderStepped:Connect(function()
    if labelsBroken then return end
    -- nothing detected and nothing drawn -> no work at all
    if next(modTargets) == nil and next(modLabels) == nil then return end

    -- remove labels for players who are no longer detected / left
    for name, e in pairs(modLabels) do
        if not modTargets[name] then
            pcall(function() e.d:Remove() end)
            modLabels[name] = nil
        end
    end

    for name, mode in pairs(modTargets) do
        local e = modLabels[name]
        if not e then
            local d = makeModLabel()
            if not d then
                labelsBroken = true
                return
            end
            e = { d = d, vis = false }
            modLabels[name] = e
        end

        -- cached part; only re-resolved when it disappears (respawn / leave)
        local part = e.part
        if not part or part.Parent == nil then
            local plr = e.plr
            if not plr or plr.Parent == nil then
                plr = Players:FindFirstChild(name)
                e.plr = plr
            end
            local char = plr and plr.Character
            part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
            e.part = part
        end

        local d = e.d

        -- text / color follow the detection type; only written when it changes
        if e.mode ~= mode then
            e.mode = mode
            if mode == "god" then
                d.Text = "God Moded"
                d.Color = GOD_COLOR
            else
                d.Text = "[POSSIBLE MOD]"
                d.Color = Color3.fromRGB(255, 0, 0)
            end
        end

        if part then
            local pos, onScreen = WorldToScreen(part.Position + LABEL_OFFSET)
            if onScreen then
                d.Position = Vector2.new(pos.X, pos.Y - 7)
                if not e.vis then d.Visible = true; e.vis = true end
            elseif e.vis then
                d.Visible = false; e.vis = false
            end
        elseif e.vis then
            d.Visible = false; e.vis = false
        end
    end
end)

