----------------------------------------------------------------------
-- NOTIFICATION BOX (reusable)
-- Bottom-right box drawn with the Drawing API, stacks upward.
-- Use it for anything:
--   Notification.push("Title", "Message")
--   Notification.push("Title", "Message", { seconds = 15, color = Color3.fromRGB(255,160,0) })
----------------------------------------------------------------------
local Notification = {}
do
    local slots = {}
    local DEFAULT_COLOR = Color3.fromRGB(255, 80, 80)
    local BG_COLOR = Color3.fromRGB(25, 25, 30)
    local TITLE_COLOR = Color3.fromRGB(255, 255, 255)
    local TEXT_COLOR = Color3.fromRGB(200, 200, 200)
    local W, H = 300, 54

    function Notification.push(title, message, opts)
        opts = opts or {}
        local seconds = opts.seconds or 10
        local accent = opts.color or DEFAULT_COLOR

        local slot = 1
        while slots[slot] do slot = slot + 1 end
        slots[slot] = true

        task.spawn(function()
            local created = {} -- every drawing made, so cleanup always removes them

            local function make(class, props)
                local d = Drawing.new(class)
                created[#created + 1] = d
                for k, v in pairs(props) do
                    d[k] = v
                end
                return d
            end

            local built = pcall(function()
                local view = Workspace.CurrentCamera.ViewportSize
                local x = view.X - W - 20
                local y = view.Y - (H + 10) * slot - 10

                make("Square", {
                    Filled = true, Color = BG_COLOR,
                    Position = Vector2.new(x, y), Size = Vector2.new(W, H),
                    ZIndex = 1, Visible = true,
                })
                make("Square", {
                    Filled = true, Color = accent,
                    Position = Vector2.new(x, y), Size = Vector2.new(4, H),
                    ZIndex = 2, Visible = true,
                })
                make("Text", {
                    Text = title, Color = TITLE_COLOR,
                    Font = Drawing.Fonts.SystemBold, Size = 16,
                    Position = Vector2.new(x + 14, y + 8),
                    ZIndex = 3, Visible = true,
                })
                make("Text", {
                    Text = message, Color = TEXT_COLOR,
                    Font = Drawing.Fonts.System, Size = 14,
                    Position = Vector2.new(x + 14, y + 29),
                    ZIndex = 3, Visible = true,
                })
            end)

            if built then
                wait(seconds)
            else
                warn("[Notification] failed to draw")
            end

            for _, d in ipairs(created) do
                pcall(function() d:Remove() end)
            end
            slots[slot] = nil
        end)
    end
end

local STAFF_NOTIFY = { seconds = 30, color = Color3.fromRGB(255, 80, 80) }
local REPORT_NOTIFY = { seconds = 10, color = Color3.fromRGB(255, 170, 0) }

