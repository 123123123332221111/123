-- Counts errors caught while the script runs; the final "loaded" line needs this to be 0.
-- The first caught error is also printed once as a warning so it is not hidden.
local loadErrors = 0
local warnedOnce = false
local function guarded(fn)
    local ok, err = pcall(fn)
    if not ok then
        loadErrors = loadErrors + 1
        if not warnedOnce then
            warnedOnce = true
            warn("FurryHook error:", err)
        end
    end
end

