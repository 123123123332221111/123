-- An item is shown if it is in the list AND at least one of its categories
-- is not hidden (so an item listed twice, e.g. R700, stays visible while any
-- of its categories is still on).
local function isItemShown(name)
    local cats = ITEM_CATEGORIES[name]
    if not cats then return false end
    for i = 1, #cats do
        if not invHidden[cats[i]] then return true end
    end
    return false
end

-- Reads a list of inventory children into display rows.
--  * items not in the list (or in a hidden category) get no row of their own,
--    but anything listed inside them is still shown (at the same indent)
--  * items that contain shown items are written as  Name { ... }
local function collectInventory(children, depth, out, state)
    for i = 1, #children do
        if state.count >= INV_MAX_NODES then
            state.truncated = true
            return
        end
        local c = children[i]
        local name = c.Name

        if c.ClassName == "Folder" then
            collectInventory(c:GetChildren(), depth, out, state) -- container only
        else
            state.count = state.count + 1

            local kids = c:GetChildren()
            if isItemShown(name) then
                if #kids > 0 and depth < INV_MAX_DEPTH then
                    local start = #out + 1
                    out[start] = INDENTS[depth] .. name .. " {"
                    collectInventory(kids, depth + 1, out, state)
                    if #out == start then
                        out[start] = INDENTS[depth] .. name -- nothing shown inside: no braces
                    else
                        out[#out + 1] = INDENTS[depth] .. "}"
                    end
                else
                    out[#out + 1] = INDENTS[depth] .. name
                end
            elseif #kids > 0 then
                collectInventory(kids, depth, out, state) -- not shown, but look inside it
            end
        end
    end
end

local function updateInvPanel(name)
    local folder = getPlayersFolder()
    local plr = folder and folder:FindFirstChild(name)
    local inv = plr and plr:FindFirstChild("Inventory")

    local out = invOut
    for i = #out, 1, -1 do out[i] = nil end -- clear the reused buffer

    if not inv then
        out[1] = "No inventory found"
    else
        for i = 1, #CATEGORY_TOGGLES do
            local t = CATEGORY_TOGGLES[i]
            invHidden[t.cat] = UI.GetValue(t.id) == true
        end

        local state = invState
        state.count = 0
        state.truncated = false
        collectInventory(inv:GetChildren(), 0, out, state)
        if state.truncated then out[#out + 1] = "..." end
        if #out == 0 then out[1] = "(nothing to show)" end
    end

    -- keep within the pooled rows
    if #out > INV_MAX_LINES then
        local extra = #out - (INV_MAX_LINES - 1)
        for i = #out, INV_MAX_LINES, -1 do out[i] = nil end
        out[INV_MAX_LINES] = "... +" .. extra .. " more"
    end

    -- only write text that actually changed
    if invCache.name ~= name then
        invCache.name = name
        invName.Text = name
    end
    local lines = invCache.lines
    for i = 1, #out do
        if lines[i] ~= out[i] then
            lines[i] = out[i]
            invLines[i].Text = out[i]
        end
    end
    setInvLineCount(#out)
end

