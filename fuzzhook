    if n == invLineCount then return end
    if invVisible then
        for i = n + 1, invLineCount do invLines[i].Visible = false end
        for i = invLineCount + 1, n do invLines[i].Visible = true end
    end
    invLineCount = n
    invBg.Size = Vector2.new(INV_W, 70 + n * INV_ROW_H)
end

-- Reads a list of inventory children into display rows.
-- Always walks everything (so every name gets a toggle), but only emits rows
-- for items that are not hidden and are not inside a hidden item.
local function collectInventory(children, depth, out, hide, state)
    for i = 1, #children do
        if state.count >= INV_MAX_NODES then
            state.truncated = true
            return
        end
        local c = children[i]
        local name = c.Name

        if c.ClassName == "Folder" then
            collectInventory(c:GetChildren(), depth, out, hide, state) -- container only
        else
            state.count = state.count + 1
            registerItem(name)

            local hideThis = hide or invHidden[ITEM_CATEGORY[name] or MISC] == true
            local kids = c:GetChildren()
            local nested = #kids > 0 and depth < INV_MAX_DEPTH

            if nested then
                if not hideThis then out[#out + 1] = INDENTS[depth] .. name .. " {" end
                collectInventory(kids, depth + 1, out, hideThis, state)
                if not hideThis then out[#out + 1] = INDENTS[depth] .. "}" end
            elseif not hideThis then
                out[#out + 1] = INDENTS[depth] .. name
            end
        end
    end
end

local function updateInvPanel(name)
    local folder = getPlayersFolder()
    local plr = folder and folder:FindFirstChild(name)
    local inv = plr and plr:FindFirstChild("Inventory")

    local out = {}
    if not inv then
        out[1] = "No inventory found"
    else
        for i = 1, #CATEGORY_TOGGLES do
            local t = CATEGORY_TOGGLES[i]
            invHidden[t.cat] = UI.GetValue(t.id) == true
        end

        local state = { count = 0, truncated = false }
        collectInventory(inv:GetChildren(), 0, out, false, state)
        if state.truncated then out[#out + 1] = "..." end
        if #out == 0 then out[1] = "(empty)" end
    end

    -- keep within the pooled rows
    if #out > INV_MAX_LINES then
        local extra = #out - (INV_MAX_LINES - 1)
        for i = #out, INV_MAX_LINES, -1 do out[i] = nil end
        out[INV_MAX_LINES] = "... +" .. extra .. " more"
    end

    -- only write text that actually changed
    if invCache.name ~= name then
        invCache.name = name
        invName.Text = name
    end
    local lines = invCache.lines
    for i = 1, #out do
        if lines[i] ~= out[i] then
            lines[i] = out[i]
            invLines[i].Text = out[i]
        end
    end
    setInvLineCount(#out)
end

----------------------------------------------------------------------
-- Shared step: one "looked-at player" pick feeds both panels
----------------------------------------------------------------------
local infoTarget, infoLastRead = nil, 0
local invTarget, invLastRead = nil, 0

local function infoStep()
    local wantInfo = panelOK and UI.GetValue("opt_info")
    local wantInv = invOK and UI.GetValue("opt_inv")
    local target = (wantInfo or wantInv) and findLookedAtPlayer() or nil
    local now = tick()

    -- Player Info (re-read only when the target changes or every INFO_REFRESH seconds)
    if wantInfo and target then
        if target ~= infoTarget or now - infoLastRead >= INFO_REFRESH then
            infoTarget = target
            infoLastRead = now
            local reportsStr, playStr = readPlayerInfo(target)
            updateInfoPanel(target, reportsStr, playStr)
        end
        showInfoPanel(true)
    else
        infoTarget = nil
        showInfoPanel(false)
    end

    -- Inv Aim
    if wantInv and target then
        if target ~= invTarget or now - invLastRead >= INFO_REFRESH then
            invTarget = target
            invLastRead = now
            updateInvPanel(target)
        end
        showInvPanel(true)
    else
        invTarget = nil
        showInvPanel(false)
    end
end

task.spawn(function()
    while true do
        pcall(infoStep)
        wait(INFO_SELECT_EVERY)
    end
end)

