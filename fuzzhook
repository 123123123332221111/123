----------------------------------------------------------------------
-- DRAGGING
-- Hold the left mouse button on a panel's top bar (DRAG_HEADER_H px) and move.
-- Panels are clamped to the screen. Positions reset on re-execute (or with the
-- "Reset UI Positions" button).
----------------------------------------------------------------------
local dragMouse = Players.LocalPlayer:GetMouse()
local dragPanel, dragOX, dragOY = nil, 0, 0
local dragWasDown = false

local function dragStep()
    if not ismouse1pressed() then
        dragPanel = nil
        dragWasDown = false
        return
    end

    local mx, my = dragMouse.X, dragMouse.Y + MOUSE_Y_OFFSET

    -- grab: only on the frame the button goes down, topmost (last created) panel first
    if not dragWasDown and isrbxactive() then
        for i = #panels, 1, -1 do
            local p = panels[i]
            if p.shown then
                local top = panelTop(p)
                if mx >= p.x and mx <= p.x + p.w and my >= top and my <= top + DRAG_HEADER_H then
                    dragPanel = p
                    dragOX = mx - p.x
                    dragOY = my - top
                    break
                end
            end
        end
    end
    dragWasDown = true

    local p = dragPanel
    if p then
        local view = Workspace.CurrentCamera.ViewportSize
        local nx = clamp(mx - dragOX, 0, view.X - p.w)
        local ntop = clamp(my - dragOY, 0, view.Y - p.h)
        local ny = p.bottom and (ntop + p.h) or ntop
        if nx ~= p.x or ny ~= p.y then
            p.x, p.y = nx, ny
            placePanel(p)
        end
    end
end

RunService.RenderStepped:Connect(function()
    guarded(dragStep)
end)

