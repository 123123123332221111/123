    if n > 0 then
        local text = "Staff Detected (" .. total .. ")"
        if text ~= slCountText then
            slCountText = text
            slCount.Text = text
        end
    end
    slCount.Visible = n > 0
    slSep.Visible = n > 0

    for i = 1, SL_MAX_ROWS do
        slRows[i].Visible = (i <= n)
    end

    slPanel.active = SL_STATIC_COUNT + n
    placePanel(slPanel) -- bottom edge stays put, so the panel grows upward
end

local function renderStaffPanel()
    local names = {}
    for name in pairs(staffSet) do
        names[#names + 1] = name
    end
    table.sort(names)

    local total = #names
    local n = (total < SL_MAX_ROWS) and total or SL_MAX_ROWS
    for i = 1, n do
        local text = names[i]
        if total > SL_MAX_ROWS and i == SL_MAX_ROWS then
            text = "+" .. (total - SL_MAX_ROWS + 1) .. " more"
        end
        if slRowText[i] ~= text then
            slRowText[i] = text
            slRows[i].Text = text
        end
    end
    layoutStaffPanel(n, total)
end

local function setStaffPanelVisible(v)
    if v == slVisible then return end
    slVisible = v
    slPanel.shown = v
    slBg.Visible = v
    slDot.Visible = v
    slTitle.Visible = v
    if not v then
        slCount.Visible = false
        slSep.Visible = false
        for i = 1, SL_MAX_ROWS do slRows[i].Visible = false end
    else
        staffDirty = true -- redraw rows when the panel is shown again
    end
end

-- Reads Passes for players that are still waiting for them
local function processStaffPending()
    if next(staffPending) == nil then return end
    local folder = getPlayersFolder()
    if not folder then return end

    for name, tries in pairs(staffPending) do
        local passes = getPasses(folder, name)
        if passes then
            staffPending[name] = nil
            staffChecked[name] = true
            local isMe = (name == LOCAL_NAME)
            local tag = (not isMe or STAFF_LIST_INCLUDE_SELF) and findStaffTag(passes)
            if tag then
                staffSet[name] = true
                staffDirty = true
                if not isMe then
                    modTargets[name] = true -- [POSSIBLE MOD] label
                    local label = TAG_LABELS[tag] or tag
                    Notification.push("Staff Detector", name .. " has " .. label, STAFF_NOTIFY)
                end
            end
        elseif tries >= SL_MAX_TRIES then
            staffPending[name] = nil
            staffChecked[name] = true -- gave up; checked again the next time they join
        else
            staffPending[name] = tries + 1
        end
    end
end

-- Scans game.Players: queues players we have not checked yet, drops ones that are gone
local function syncStaff()
    local present = staffPresent
    for k in pairs(present) do present[k] = nil end -- reuse the table

    local list = Players:GetPlayers()
    for i = 1, #list do
        local name = list[i].Name
        present[name] = true
        if not staffChecked[name] and staffPending[name] == nil then
            staffPending[name] = 0
        end
    end

    for name in pairs(staffChecked) do
        if not present[name] then
            staffChecked[name] = nil
            if staffSet[name] then
                staffSet[name] = nil
                staffDirty = true
            end
            modTargets[name] = nil
        end
    end
    for name in pairs(staffPending) do
        if not present[name] then staffPending[name] = nil end
    end

    processStaffPending()
end

-- Worker (once a second while the list is on): picks up joins/leaves, retries
-- pending players, and redraws only when something changed
local function staffStep()
    local on = slOK and UI.GetValue("opt_stafflist")
    if on then
        syncStaff()
        setStaffPanelVisible(true)
        if staffDirty then
            staffDirty = false
            renderStaffPanel()
        end
    else
        if staffWasOn then
            -- turned off: reset everything so a fresh scan runs when it is turned back on
            staffSet, staffChecked, staffPending, modTargets = {}, {}, {}, {}
        end
        setStaffPanelVisible(false)
    end
    staffWasOn = on and true or false
end

task.spawn(function()
    while true do
        guarded(staffStep)
        wait(1)
    end
end)

STATUS.slOK = slOK
end -- BLOCK: staff list

----------------------------------------------------------------------
-- SERVER LOOT SCANNER PANEL (right side by default)
-- A pass over the server takes about LOOT_REFRESH seconds: players still in
-- game.Players that also exist in ReplicatedStorage.Players are scanned ONE
-- PER TICK, and a big inventory is read in slices of LOOT_SLICE objects with a
-- yield between slices, so no single frame ever does a huge amount of work.
-- Every LOOT_ITEMS match anywhere inside their Inventory is counted (also when
-- it sits inside clothing, bags or other items). The panel is redrawn when a
-- full pass finishes. Only players that have at least one of the items are
-- listed:
--   PlayerName
--     R700
--     338AP (32x)
-- "(Nx)" is only written when a player has more than one of that item.
-- Each inventory object with a matching name counts as one.
----------------------------------------------------------------------
do -- BLOCK: server loot
local LOOT_W = 200
local LOOT_ROW_H = 14
local LOOT_ROW_Y = 28
local LOOT_STATIC_COUNT = 3 -- bg, dot, title

local LOOT_SET = {} -- [itemName] = position in LOOT_ITEMS
for i = 1, #LOOT_ITEMS do
    LOOT_SET[LOOT_ITEMS[i]] = i
end

local lootView = Workspace.CurrentCamera.ViewportSize
local lootPanel = newPanel("loot", math.floor(lootView.X - LOOT_W - 20), 20, LOOT_W, 36)
local lootStatic = {}       -- bg, dot, title
local lootRows = {}         -- pooled text rows
local lootRowText, lootRowKind = {}, {}
local lootRowCount = 0
local lootVisible = false
local lootBg, lootTitle
local lootTitleText = ""
local lootLastScan = 0

local LOOT_WHITE = Color3.fromRGB(255, 255, 255)
local LOOT_GRAY = Color3.fromRGB(190, 190, 200)

local lootOK = pcall(function()
    lootBg = addItem(lootPanel, "Square", {
        Filled = true, Color = Color3.fromRGB(22, 22, 28),
        Size = Vector2.new(LOOT_W, 36), ZIndex = 1, Visible = false,
    }, 0, 0, true)
    pcall(function() lootBg.Corner = 8 end)
    lootStatic[1] = lootBg

    lootStatic[2] = addItem(lootPanel, "Square", {
        Filled = true, Color = Color3.fromRGB(130, 110, 255),
        Size = Vector2.new(6, 6), ZIndex = 2, Visible = false,
    }, 12, 12)
    lootTitle = addItem(lootPanel, "Text", {
        Text = "Server Loot", Color = LOOT_WHITE,
        Font = Drawing.Fonts.SystemBold, Size = 12,
        ZIndex = 2, Visible = false,
    }, 24, 8)
    lootStatic[3] = lootTitle

    for i = 1, LOOT_MAX_ROWS do
        lootRows[i] = addItem(lootPanel, "Text", {
            Text = "", Color = LOOT_GRAY,
            Font = Drawing.Fonts.System, Size = 12,
            ZIndex = 2, Visible = false,
        }, 12, LOOT_ROW_Y + (i - 1) * LOOT_ROW_H)
        lootRowKind[i] = 2 -- 1 = player name row, 2 = item row
    end
end)

if not lootOK then
    destroyPanel(lootPanel)
    lootStatic, lootRows = {}, {}
end

lootPanel.active = LOOT_STATIC_COUNT -- grows with the number of rows shown

local function showLoot(visible)
    if visible == lootVisible then return end
    for i = 1, #lootStatic do
        lootStatic[i].Visible = visible
    end
    for i = 1, lootRowCount do
        lootRows[i].Visible = visible
    end
    lootVisible = visible
    lootPanel.shown = visible
end

-- Names of players that are still in the server AND exist in ReplicatedStorage.Players
local function lootGetNames(out)
    local folder = getPlayersFolder()
    if not folder then return end
    local list = Players:GetPlayers()
    for i = 1, #list do
        local name = list[i].Name
        if (LOOT_INCLUDE_SELF or name ~= LOCAL_NAME) and folder:FindFirstChild(name) then
            out[#out + 1] = name
        end
    end
    table.sort(out)
end

-- Returns the descendants of one player's Inventory (nil if there is none)
local function lootGetDesc(name)
    local folder = getPlayersFolder()
    local plr = folder and folder:FindFirstChild(name)
    local inv = plr and plr:FindFirstChild("Inventory")
    return inv and inv:GetDescendants()
end

-- Counts LOOT_ITEMS in desc[from..to] into counts. Returns true if anything matched.
local function lootScanSlice(desc, from, to, counts)
    local found = false
    for i = from, to do
        local idx = LOOT_SET[desc[i].Name]
        if idx then
            counts[idx] = (counts[idx] or 0) + 1
            found = true
        end
    end
    return found
end

-- Counts the LOOT_ITEMS inside one player's Inventory, a slice at a time.
-- Returns nil if they have none. counts[i] = amount of LOOT_ITEMS[i].
-- The yield between slices is OUTSIDE pcall on purpose.
local function lootScanPlayer(name)
    local ok, desc = pcall(lootGetDesc, name)
    if not ok then
        loadErrors = loadErrors + 1
        return nil
    end
    if not desc then return nil end

    local limit = #desc
    if limit > LOOT_MAX_NODES then limit = LOOT_MAX_NODES end

    local counts, found, from = {}, false, 1
    while from <= limit do
        local to = from + LOOT_SLICE - 1
        if to > limit then to = limit end

        local ok2, hit = pcall(lootScanSlice, desc, from, to, counts)
        if not ok2 then
            loadErrors = loadErrors + 1
        elseif hit then
            found = true
        end

        from = to + 1
        if from <= limit then task.wait() end -- let the game render before the next slice
    end

    if found then return counts end
    return nil
end

-- results[i] = { name = playerName, counts = { [itemIndex] = amount } }
local function renderLoot(results)
    local texts, kinds = {}, {}
    for i = 1, #results do
        local r = results[i]
        texts[#texts + 1] = r.name
        kinds[#kinds + 1] = 1
        for idx = 1, #LOOT_ITEMS do
            local c = r.counts[idx]
            if c then
                if c > 1 then
                    texts[#texts + 1] = "  " .. LOOT_ITEMS[idx] .. " (" .. c .. "x)"
                else
                    texts[#texts + 1] = "  " .. LOOT_ITEMS[idx]
                end
                kinds[#kinds + 1] = 2
            end
        end
    end
    if #texts == 0 then
        texts[1] = "No loot found"
        kinds[1] = 2
    end

    -- keep within the pooled rows
    if #texts > LOOT_MAX_ROWS then
        local extra = #texts - (LOOT_MAX_ROWS - 1)
        for i = #texts, LOOT_MAX_ROWS, -1 do
            texts[i] = nil
            kinds[i] = nil
        end
        texts[LOOT_MAX_ROWS] = "... +" .. extra .. " more"
        kinds[LOOT_MAX_ROWS] = 2
    end

    -- only write what changed
    local n = #texts
    for i = 1, n do
        if lootRowText[i] ~= texts[i] then
            lootRowText[i] = texts[i]
            lootRows[i].Text = texts[i]
        end
        if lootRowKind[i] ~= kinds[i] then
            lootRowKind[i] = kinds[i]
            if kinds[i] == 1 then
                lootRows[i].Font = Drawing.Fonts.SystemBold
                lootRows[i].Color = LOOT_WHITE
            else
                lootRows[i].Font = Drawing.Fonts.System
                lootRows[i].Color = LOOT_GRAY
            end
        end
    end

    if n ~= lootRowCount then
        if lootVisible then
            for i = n + 1, lootRowCount do lootRows[i].Visible = false end
            for i = lootRowCount + 1, n do lootRows[i].Visible = true end
        end
        lootRowCount = n
        lootPanel.h = LOOT_ROW_Y + n * LOOT_ROW_H + 8
        lootBg.Size = Vector2.new(LOOT_W, lootPanel.h)
        lootPanel.active = LOOT_STATIC_COUNT + n
        placePanel(lootPanel) -- positions any newly used rows (they may have been left behind by a drag)
    end

    local title = "Server Loot (" .. #results .. ")"
    if title ~= lootTitleText then
        lootTitleText = title
        lootTitle.Text = title
    end
end

-- Round-robin worker: one player per tick, results cached per player and the
-- panel redrawn when a full pass completes.
local lootCache = {}        -- [name] = counts table, or false when the player has none
local lootQueue = {}        -- names for the current pass
local lootPos = 1           -- next index in lootQueue
local lootDirty = false     -- a pass finished and the panel has not been redrawn yet

task.spawn(function()
    while true do
        local sleep = 0.5
        if lootOK and UI.GetValue("opt_four") then
            showLoot(true)

            -- start a new pass when the previous one is done and the refresh time has passed
            if lootPos > #lootQueue and tick() - lootLastScan >= LOOT_REFRESH then
                lootLastScan = tick()

                local names = {}
                if not pcall(lootGetNames, names) then loadErrors = loadErrors + 1 end
                lootQueue, lootPos, lootDirty = names, 1, true

                -- drop cached players who left
                local keep = {}
                for i = 1, #names do keep[names[i]] = true end
                for name in pairs(lootCache) do
                    if not keep[name] then lootCache[name] = nil end
                end
            end

            if lootPos <= #lootQueue then
                local name = lootQueue[lootPos]
                lootPos = lootPos + 1
                lootCache[name] = lootScanPlayer(name) or false
                sleep = clamp(LOOT_REFRESH / #lootQueue, 0.05, 0.5)
            elseif lootDirty then
                lootDirty = false
                local results = {}
                for i = 1, #lootQueue do
                    local c = lootCache[lootQueue[i]]
                    if c then results[#results + 1] = { name = lootQueue[i], counts = c } end
                end
                guarded(function() renderLoot(results) end)
            end
        else
            showLoot(false)
            lootLastScan = 0 -- start a pass right away when it is switched back on
            lootQueue, lootPos, lootCache, lootDirty = {}, 1, {}, false
        end
        wait(sleep)
    end
end)

STATUS.lootOK = lootOK
end -- BLOCK: server loot

