-- Parsed once at load:
--   CATEGORIES      = category names in list order (the toggles use this order)
--   ITEM_CATEGORIES = [itemName] = { category, ... } (an item can be in several categories)
local CATEGORIES = {}
local ITEM_CATEGORIES = {}

do
    local function titleCase(s)
        return (string.gsub(s, "(%a)([%w']*)", function(a, b)
            return string.upper(a) .. string.lower(b)
        end))
    end

    local current
    for raw in string.gmatch(ITEM_LIST_TEXT, "[^\r\n]+") do
        local line = string.match(raw, "^%s*(.-)%s*$")
        if line ~= "" then
            local header = string.match(line, "^!%s*(.-)%s*!$")
            if header then
                current = titleCase(header)
                local seen = false
                for i = 1, #CATEGORIES do
                    if CATEGORIES[i] == current then seen = true break end
                end
                if not seen then CATEGORIES[#CATEGORIES + 1] = current end
            elseif current then
                local cats = ITEM_CATEGORIES[line]
                if not cats then
                    cats = {}
                    ITEM_CATEGORIES[line] = cats
                end
                local has = false
                for i = 1, #cats do
                    if cats[i] == current then has = true break end
                end
                if not has then cats[#cats + 1] = current end
            end
        end
    end
end

