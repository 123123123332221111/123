-- Cached player list + HumanoidRootParts for the "looked at" pick.
-- The list is refreshed every PLAYER_LIST_REFRESH seconds (GetPlayers allocates a
-- new table each call) and the HRP cache is keyed by NAME (stable) and cleared
-- on each refresh so players who left drop out.
local hrpCache = {}
local plrList, plrListAt = {}, -100

local function getPlayerList(now)
    if now - plrListAt >= PLAYER_LIST_REFRESH then
        plrList = Players:GetPlayers()
        plrListAt = now
        hrpCache = {}
    end
    return plrList
end

-- Closest player to the screen center within INFO_RADIUS (squared compare, no sqrt)
local function findLookedAtPlayer(now)
    local view = Workspace.CurrentCamera.ViewportSize
    local cx, cy = view.X * 0.5, view.Y * 0.5
    local bestSq = INFO_RADIUS * INFO_RADIUS
    local best

    local list = getPlayerList(now)
    for i = 1, #list do
        local plr = list[i]
        local name = plr.Name
        if name ~= LOCAL_NAME then
            local hrp = hrpCache[name]
            if not hrp or hrp.Parent == nil then
                hrp = nil
                if plr.Parent ~= nil then
                    local char = plr.Character
                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                end
                hrpCache[name] = hrp
            end
            if hrp then
                local pos, onScreen = WorldToScreen(hrp.Position)
                if onScreen then
                    local dx, dy = pos.X - cx, pos.Y - cy
                    local sq = dx * dx + dy * dy
                    if sq < bestSq then
                        bestSq = sq
                        best = name
                    end
                end
            end
        end
    end
    return best
end

-- Returns formatted Reports and Playtime strings ("?" when unavailable)
local function readPlayerInfo(name)
    local folder = getPlayersFolder()
    local n = folder and folder:FindFirstChild(name)
    local status = n and n:FindFirstChild("Status")

    local ws = status and status:FindFirstChild("Journey")
    ws = ws and ws:FindFirstChild("WipeStatistics")
    local played = ws and ws:GetAttribute("TimePlayed")

    local rep = status and status:FindFirstChild("UAC")
    rep = rep and rep:FindFirstChild("Reports")
    local reports = rep and rep:GetAttribute("1")

    local reportsStr = "Reports: " .. (type(reports) == "number" and tostring(reports) or "?")
    local playStr = "Playtime: " .. (type(played) == "number" and string.format("%.1fh", played / 3600) or "?")
    return reportsStr, playStr
end

