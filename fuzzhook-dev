    -- animating; idle or hidden it costs one comparison per frame. With Performance
    -- Mode on, the fade is skipped and the panel just appears / disappears.
    -- "Hotbar Debug (prints)" (Debug Options) prints what the hotbar sees for the shown
    -- player and why an icon is not loading.
    ----------------------------------------------------------------------
    local EQUIP_MAX_NODES = 1500    -- safety cap on objects looked at per debug scan
    local EQUIP_REFRESH = 1.5       -- seconds between re-reads of the targeted player
    -- Hosts tried in order for every icon (jsDelivr caches @main for a while: after
    -- pushing new images, put the raw GitHub URL first or use a commit hash / tag).
    local IMG_BASES = {
