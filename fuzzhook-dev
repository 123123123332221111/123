    local HOT_SLOTS = { "ItemBack1", "ItemBack2", "Hotbar4", "Hotbar5", "Hotbar6", "Hotbar7", "Hotbar8" }

    local BG_COLOR = Color3.fromRGB(22, 22, 28)
    local TILE_BG = Color3.fromRGB(30, 34, 48)   -- slightly blue, like the reference
    local STROKE_COLOR = Color3.fromRGB(64, 72, 96) -- outline around each icon box
    local EQUIPPED_STROKE = Color3.fromRGB(165, 135, 255) -- brighter purple outline on the item they are holding
    local EQUIPPED_THICKNESS = 2
    local HL_TILE = Color3.fromRGB(78, 22, 56)   -- tile tint for HIGHLIGHT items
    local WHITE = Color3.fromRGB(255, 255, 255)
    local GRAY = Color3.fromRGB(190, 190, 200)

    -- Display order: head -> face -> body -> bags. Edit freely.
    local ARMOR_ORDER = {
        -- headgear
        "ScavKingHelmet", "Altyn", "UNOHelmet", "6B47", "6B27", "FastMT",
        "Pokushanka", "ZSh", "SSH68", "GMT", "Dozer",
