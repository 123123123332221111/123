-- Matcha LuaVM: FuzzyHook - dev build (draggable + transparent UI, equipment Hotbar)
-- Notes:
--  * UI.AddTab's callback runs every frame, so it only reads pre-built data
--    (no closures / string building inside it).
--  * Username and the Players folder are resolved once and cached.
--  * A feature does no work while its toggle is off.
--  * Every panel (Player Info, Inv Aim, Staff List, Hotbar, Server Loot) is draggable
--    by its top bar. Panels and notification boxes use the "UI Opacity" slider.
--  * No text has a stroke / outline.
--  * Nothing prints to the console except one line at the very end, and only
--    if everything loaded without a problem.
--  * God Mode detection lives inside the Staff List block (it shares that block's
--    scan loop, so it is controlled by the "Staff Alert" toggle).
--  * Performance Mode (Settings section) turns off the Hotbar fade and the
--    notification slide animations. The flag lives in Notification.perf.

local Players, ReplicatedStorage, RunService, Workspace
-- Username is resolved ONCE at launch and reused by every feature below.
local LOCAL_NAME

-- The services, your player and the camera may not exist yet if the script is
-- executed while the game is still loading (that was the "attempt to index nil with
-- 'LocalPlayer'" error). Retry for up to ~2 minutes before giving up.
do
    for _ = 1, 240 do
        local ready = pcall(function()
            Players = game:GetService("Players")
            ReplicatedStorage = game:GetService("ReplicatedStorage")
            RunService = game:GetService("RunService")
            Workspace = game:GetService("Workspace")
            LOCAL_NAME = Players.LocalPlayer.Name
            assert(Workspace.CurrentCamera ~= nil, "camera not ready")
        end)
        if ready then break end
        wait(0.5)
    end

    if not (Players and ReplicatedStorage and RunService and Workspace and LOCAL_NAME) then
        warn("FuzzyHook - PRIVATE: the game did not finish loading, script stopped")
        return
    end
end

-- Counts errors caught while the script runs; the final "loaded" line needs this to be 0.
local loadErrors = 0
local function guarded(fn)
    local ok = pcall(fn)
    if not ok then loadErrors = loadErrors + 1 end
end

