    local IMG_RETRY = 60

    local PAD = 12
    local TILE, GAP, IMG_PAD = 64, 8, 4   -- bigger tiles so the icons are easy to see
    local PILL_H, PILL_GAP = 24, 8        -- name pill on top, space under it
