-- "Print Most Wanted" button: only scans ReplicatedStorage.ReportList.MostWanted when clicked.
-- Each child is named "<username>_<userid>" and holds the report count in attribute "1".
local function onMostWantedClick()
    local ok, err = pcall(function()
        local list = ReplicatedStorage:FindFirstChild("ReportList")
        list = list and list:FindFirstChild("MostWanted")
        if not list then
            print("[Most Wanted] list not found")
            return
        end

        local kids = list:GetChildren()
        if #kids == 0 then
            print("[Most Wanted] list is empty")
            return
        end

        print("[Most Wanted] " .. #kids .. " players:")
        for i = 1, #kids do
            local kid = kids[i]
            -- strip the trailing "_<userid>" (usernames can contain underscores too)
            local username = string.match(kid.Name, "^(.*)_%d+$") or kid.Name
            local reports = kid:GetAttribute("1")
            print(username .. " - " .. (type(reports) == "number" and tostring(reports) or "?") .. " reports")
        end
    end)
    if not ok then
        print("[Most Wanted] error: " .. tostring(err))
    end
