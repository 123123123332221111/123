-- Closest player to the screen center within INFO_RADIUS (squared compare, no sqrt)
local function findLookedAtPlayer()
    local view = Workspace.CurrentCamera.ViewportSize
    local cx, cy = view.X * 0.5, view.Y * 0.5
    local bestSq = INFO_RADIUS * INFO_RADIUS
    local best

    for _, plr in ipairs(Players:GetPlayers()) do
        local name = plr.Name
        if name ~= LOCAL_NAME then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, onScreen = WorldToScreen(hrp.Position)
                if onScreen then
                    local dx, dy = pos.X - cx, pos.Y - cy
                    local sq = dx * dx + dy * dy
                    if sq < bestSq then
                        bestSq = sq
                        best = name
                    end
                end
            end
        end
    end
    return best
end

-- Returns formatted Reports and Playtime strings ("?" when unavailable)
local function readPlayerInfo(name)
    local folder = getPlayersFolder()
    local n = folder and folder:FindFirstChild(name)
    local status = n and n:FindFirstChild("Status")

    -- TimePlayed (seconds): Journey.Statistics first, Journey.WipeStatistics as the fallback
    local journey = status and status:FindFirstChild("Journey")
    local st = journey and journey:FindFirstChild("Statistics")
    local played = st and st:GetAttribute("TimePlayed")
    if type(played) ~= "number" then
        local ws = journey and journey:FindFirstChild("WipeStatistics")
        played = ws and ws:GetAttribute("TimePlayed")
    end

    local rep = status and status:FindFirstChild("UAC")
    rep = rep and rep:FindFirstChild("Reports")
    local reports = rep and rep:GetAttribute("1")

    local reportsStr = "Reports: " .. (type(reports) == "number" and tostring(reports) or "?")
    local playStr = "Playtime: " .. (type(played) == "number" and string.format("%.1fh", played / 3600) or "?")
    return reportsStr, playStr
end

-- (own scope: Inv Aim panel; shares invOK, showInvPanel, updateInvPanel)
local invOK, showInvPanel, updateInvPanel
do
    ----------------------------------------------------------------------
    -- INV AIM PANEL (below Player Info by default)
    -- Shows everything inside ReplicatedStorage.Players.<name>.Inventory for the
    -- player you are looking at. Nothing is hardcoded: every item is read by
    -- whatever name it has, items that contain other items are shown as
    --   Name {
    --       inner item
    --   }
    -- and Folder objects are treated as plain containers (their contents are
    -- shown, the folder itself is not). Only items in ITEM_LIST_TEXT (top of the
    -- file) are shown, and each category in that list has a "Filter" toggle.
    -- KEYCHAIN: everything inside a Keychain is shown (even items that are not in
    -- the list). "Filter Keychain" hides the Keychain and everything inside it.
    ----------------------------------------------------------------------
    local INDENTS = { [0] = "", "   ", "      ", "         ", "            " }
    local INV_X, INV_Y, INV_W = 20, 148, 210
    local INV_ROW_H = 16
    -- Any item whose name contains "keychain" (any capitalisation, e.g. KeyChain, Keychain1)
    local function isKeychainName(name)
        return string.find(string.lower(name), "keychain", 1, true) ~= nil
    end

    local invPanel = newPanel("inv", INV_X, INV_Y, INV_W, 70)
    local invStatic = {}        -- the 5 static drawings (box, dot, title, name, separator)
    local invLines = {}         -- pooled text rows
    local invCache = { name = "", lines = {} }
    local invLineCount = 0
    local invVisible = false
    local invBg, invName
    local invHidden = {}        -- [categoryName] = true while its "Filter" toggle is on

    invOK = pcall(function()
        local GRAY = Color3.fromRGB(190, 190, 200)

        invBg = addItem(invPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(22, 22, 28),
            Size = Vector2.new(INV_W, 70), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() invBg.Corner = 8 end)
        invStatic[1] = invBg

        invStatic[2] = addItem(invPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(130, 110, 255),
            Size = Vector2.new(6, 6), ZIndex = 2, Visible = false,
        }, 12, 12)
        invStatic[3] = addItem(invPanel, "Text", {
            Text = "Inv Aim", Color = Color3.fromRGB(255, 255, 255),
            Font = Drawing.Fonts.SystemBold, Size = 12,
            ZIndex = 2, Visible = false,
        }, 24, 8)
        invName = addItem(invPanel, "Text", {
            Text = "", Color = GRAY,
            Font = Drawing.Fonts.SystemBold, Size = 13,
            ZIndex = 2, Visible = false,
        }, 12, 30)
        invStatic[4] = invName
        invStatic[5] = addItem(invPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(80, 80, 92),
            Size = Vector2.new(INV_W - 24, 1), ZIndex = 2, Visible = false,
        }, 12, 52)

        for i = 1, INV_MAX_LINES do
            invLines[i] = addItem(invPanel, "Text", {
                Text = "", Color = GRAY,
                Font = Drawing.Fonts.System, Size = 13,
                ZIndex = 2, Visible = false,
            }, 12, 62 + (i - 1) * INV_ROW_H)
        end
    end)

    if not invOK then
        destroyPanel(invPanel)
        invStatic, invLines = {}, {}
    end

    local INV_STATIC_COUNT = 5

    function showInvPanel(visible)
        if visible == invVisible then return end
        for i = 1, INV_STATIC_COUNT do
            invStatic[i].Visible = visible
        end
        for i = 1, invLineCount do
            invLines[i].Visible = visible
        end
        invVisible = visible
        invPanel.shown = visible
    end

    local function setInvLineCount(n)
        if n == invLineCount then return end
        if invVisible then
            for i = n + 1, invLineCount do invLines[i].Visible = false end
            for i = invLineCount + 1, n do invLines[i].Visible = true end
        end
        invLineCount = n
        invPanel.h = 70 + n * INV_ROW_H
        invBg.Size = Vector2.new(INV_W, invPanel.h)
    end

    -- An item is shown if it is in the list AND at least one of its categories
    -- is not filtered (so an item listed twice, e.g. R700, stays visible while any
    -- of its categories is still on).
    local function isItemShown(name)
        local cats = ITEM_CATEGORIES[name]
        if not cats then return false end
        for i = 1, #cats do
            if not invHidden[cats[i]] then return true end
        end
        return false
    end

    -- Reads a list of inventory children into display rows.
    --  * items not in the list (or in a filtered category) get no row of their own,
    --    but anything listed inside them is still shown (at the same indent)
    --  * items that contain shown items are written as  Name { ... }
    --  * force = true while inside a Keychain: every item is shown, listed or not
    --  * a filtered Keychain (and everything in it) is skipped completely
    local function collectInventory(children, depth, out, state, force)
        for i = 1, #children do
            if state.count >= INV_MAX_NODES then
                state.truncated = true
                return
            end
            local c = children[i]
            local name = c.Name

            if c.ClassName == "Folder" then
                collectInventory(c:GetChildren(), depth, out, state, force) -- container only
            else
                state.count = state.count + 1

                local isKeychain = isKeychainName(name)
                -- "Filter Keychain" on: the keychain and everything inside it is skipped
                local filteredKeychain = isKeychain and not force and invHidden["Keychain"] == true

                if not filteredKeychain then
                    local kids = c:GetChildren()
                    -- state.all = debug toggle: show every item, listed or not
                    local shown = force or state.all or isKeychain or isItemShown(name)
                    local childForce = force or isKeychain -- everything inside a keychain is shown

                    if shown then
                        if #kids > 0 and depth < INV_MAX_DEPTH then
                            local start = #out + 1
                            out[start] = INDENTS[depth] .. name .. " {"
                            collectInventory(kids, depth + 1, out, state, childForce)
                            if #out == start then
                                out[start] = INDENTS[depth] .. name -- nothing shown inside: no braces
                            else
                                out[#out + 1] = INDENTS[depth] .. "}"
                            end
                        else
                            out[#out + 1] = INDENTS[depth] .. name
                        end
                    elseif #kids > 0 then
                        collectInventory(kids, depth, out, state, childForce) -- not shown, but look inside it
                    end
                end
            end
        end
    end

    function updateInvPanel(name)
        local folder = getPlayersFolder()
        local plr = folder and folder:FindFirstChild(name)
        local inv = plr and plr:FindFirstChild("Inventory")

        local out = {}
        if not inv then
            out[1] = "No inventory found"
        else
            for i = 1, #CATEGORY_TOGGLES do
                local t = CATEGORY_TOGGLES[i]
                invHidden[t.cat] = UI.GetValue(t.id) == true
            end

            local state = { count = 0, truncated = false, all = UI.GetValue("inv_showall") == true }
            collectInventory(inv:GetChildren(), 0, out, state)
            if state.truncated then out[#out + 1] = "..." end
            if #out == 0 then out[1] = "(nothing to show)" end
        end

        -- keep within the pooled rows
        if #out > INV_MAX_LINES then
            local extra = #out - (INV_MAX_LINES - 1)
            for i = #out, INV_MAX_LINES, -1 do out[i] = nil end
            out[INV_MAX_LINES] = "... +" .. extra .. " more"
        end

        -- only write text that actually changed
        if invCache.name ~= name then
            invCache.name = name
            invName.Text = name
        end
        local lines = invCache.lines
        local hls = invCache.hl
        if not hls then
            hls = {}
            invCache.hl = hls
        end
        for i = 1, #out do
            if lines[i] ~= out[i] then
                lines[i] = out[i]
                invLines[i].Text = out[i]
            end
            -- highlighted items (deep pink): item name = first word of the row
            local nm = string.match(out[i], "^%s*([^%s{]+)")
            local hl = (nm ~= nil and HIGHLIGHT[nm] == true)
            if hls[i] ~= hl then
                hls[i] = hl
                invLines[i].Color = hl and HIGHLIGHT_COLOR or NORMAL_TEXT_COLOR
            end
        end
        setInvLineCount(#out)
    end
end

-- (own scope: Hotbar panel + team row; shares hbOK, hotbarStep, iconTest)
local hbOK, hotbarStep
do
    ----------------------------------------------------------------------
    -- EQUIPMENT HOTBAR (name pill on top, then the hotbar items row (only when a slot is
    -- filled), then the equipment tiles, then the team card as the very last block; same
    -- dark / purple colors as the other panels. The tile holding the player's EquippedTool
    -- gets a brighter purple outline.)
    -- Equipment: every name in ARMOR_ORDER is looked up DIRECTLY under
    --   ReplicatedStorage.Players.<name>.Inventory
    -- (no scan of every descendant). Each name is shown once.
    -- Attachment rules (read from <item>.Attachments):
    --   * FastMT with QuadNVG AND TitanShield is shown as a GMT (icon GMT.png)
    --   * Altyn with MaskaVisor / AltynVisor shows that visor as a small icon in the
    --     bottom-right corner of the Altyn tile (the Altyn stays the main icon)
    -- Icons: downloaded once per item from the GitHub repo (jsDelivr first, raw
