    -- Attachment rules (the game item name stays the same, attachments change what is shown)
    local SUB_SIZE = 18      -- small attachment icon size (px); up to 3 stack in one column
    local ATT = {
        fastmt = { "QuadNVG", "TitanShield" },                 -- FastMT with ALL of these is really a GMT
        visors = { Altyn = { "MaskaVisor", "AltynVisor" } },   -- helmet -> visor corner icon (first one found wins)
        gun = { "RK2", "Reapir", "PEQ15", "SOCOM556" },        -- gun attachments shown as stacked corner icons
    }

    ----------------------------------------------------------------------
    -- Image cache + background downloader
    ----------------------------------------------------------------------
    -- item name in the game -> icon file name in the repo, for icons whose file name
    -- differs. The normal "<ItemName>.png" is always tried first.
    local IMG_ALIAS = {
        SSH68 = "SSH668",
        WastelandBackpack = "Wastelander",
        ScavKingHelmet = "ScavKingCrown",
    }

    local imgData, imgState, imgFailAt, imgQueue = {}, {}, {}, {}
    local imgInfo = {} -- [item] = size on success, reason on failure (for the debug button)
    local imgDirty = false -- an icon finished loading -> tiles get re-applied

    local function fetch(url)
        if httpget then return httpget(url) end
        return game:HttpGet(url)
    end

    -- Set to true to test whether Matcha can draw WebP directly (the icon files in
    -- the repo were WebP renamed to .png, which Drawing.Image may not decode).
    local ALLOW_WEBP = false

    -- Looks at the first bytes of the download: "png", "jpg", "webp" or nil
    local function imgKind(data)
        if type(data) ~= "string" then return nil end
        if string.sub(data, 2, 4) == "PNG" then return "png" end
        if string.sub(data, 1, 2) == "\255\216" then return "jpg" end
        if string.sub(data, 1, 4) == "RIFF" and string.sub(data, 9, 12) == "WEBP" then return "webp" end
        return nil
    end

    local function isPng(data)
        local k = imgKind(data)
        return k == "png" or k == "jpg" or (ALLOW_WEBP and k == "webp")
    end

    local function requestImage(item)
        if UI.GetValue("opt_icons_off") == true then return end -- Settings: "Disable Icon Loading" is on
        local st = imgState[item]
        if st == "ok" or st == "loading" then return end
        if st == "fail" and tick() - imgFailAt[item] < IMG_RETRY then return end
        imgState[item] = "loading"
        imgQueue[#imgQueue + 1] = item
    end

    -- Tries every host in IMG_BASES for "<fileName>.png". Returns the data, or nil
    -- plus the reason the last host failed.
    local function tryDownload(fileName)
        local why = "no hosts"
        for i = 1, #IMG_BASES do
            local ok, data = pcall(fetch, IMG_BASES[i] .. fileName .. ".png")
            if ok and isPng(data) and #data > 100 then
                return data
            end
            if not ok then
                why = "error: " .. tostring(data)
            elseif type(data) ~= "string" then
                why = "returned " .. type(data)
            elseif #data < 100 and string.sub(data, 1, 3) == "404" then
                why = "404 not found (" .. fileName .. ".png is not in the repo)"
            else
                why = #data .. " bytes, format: " .. tostring(imgKind(data) or "unknown")
            end
        end
        return nil, why
    end

    task.spawn(function()
        while true do
            local item = table.remove(imgQueue, 1)
            if item and UI.GetValue("opt_icons_off") == true then
                -- switched off while items were waiting: drop them without any download
                imgState[item] = nil
                item = nil
                wait(0.25)
            elseif item then
                local data, why = tryDownload(item)
                if not data and IMG_ALIAS[item] then
                    local d2, w2 = tryDownload(IMG_ALIAS[item])
                    data = d2
                    if not d2 then why = why .. " | " .. IMG_ALIAS[item] .. ": " .. tostring(w2) end
                end
                if not data then
                    -- game names and file names can differ in capitalisation (FAL -> Fal.png)
                    local alt = string.upper(string.sub(item, 1, 1)) .. string.lower(string.sub(item, 2))
                    if alt ~= item and alt ~= IMG_ALIAS[item] then
                        local d3, w3 = tryDownload(alt)
                        data = d3
                        if not d3 then why = why .. " | " .. alt .. ": " .. tostring(w3) end
                    end
                end
                if data then
                    imgData[item] = data
                    imgState[item] = "ok"
                    imgInfo[item] = #data .. " bytes"
                    imgDirty = true
                else
                    imgState[item] = "fail"
                    imgFailAt[item] = tick()
                    imgInfo[item] = why
                end
                wait(0.05)
            else
                wait(0.25)
            end
        end
    end)

    ----------------------------------------------------------------------
    -- Panel drawings
    ----------------------------------------------------------------------
    -- y = 44 keeps it below the compass bar at the top of the screen
    local hbPanel = newPanel("hotbar", math.floor((Workspace.CurrentCamera.ViewportSize.X - MIN_W) / 2), 44, MIN_W, 60)

    local rPill, rTitle, rMsgBg, rMsg, rTeamBg, rTeamHead
    local tiles = {}            -- equipment row: per tile bg, stroke, img, label, subBg, sub (records), hasImg, hasSub, eq
    local hotTiles = {}         -- hotbar-items row (same kind of tiles)
    local rTeamRows = {}

    local function make(class, props, ox, oy, isBg)
        addItem(hbPanel, class, props, ox, oy, isBg)
        return hbPanel.items[#hbPanel.items]
    end

    hbOK = pcall(function()
        -- name pill (centered over the tiles, like the reference)
        rPill = make("Square", {
            Filled = true, Color = BG_COLOR,
            Size = Vector2.new(100, PILL_H), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() rPill.d.Corner = PILL_H / 2 end)

        rTitle = make("Text", {
            Text = "", Color = WHITE,
            Font = Drawing.Fonts.SystemBold, Size = 12, Center = true,
            ZIndex = 2, Visible = false,
        }, 0, 0)

        -- small card used for "Inventory not found" / "No equipment found"
        rMsgBg = make("Square", {
            Filled = true, Color = BG_COLOR,
            Size = Vector2.new(100, 24), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() rMsgBg.d.Corner = 8 end)
        rMsg = make("Text", {
            Text = "", Color = GRAY,
            Font = Drawing.Fonts.System, Size = 13,
            ZIndex = 2, Visible = false,
        }, 0, 0)

        local function makeTile()
            local t = { hasImg = false, nsub = 0, subs = {}, subKey = nil, eq = false }

            t.bg = make("Square", {
                Filled = true, Color = TILE_BG,
                Size = Vector2.new(TILE, TILE), ZIndex = 1, Visible = false,
            }, 0, 0, true)
            pcall(function() t.bg.d.Corner = 8 end)

            -- outline around the box; registered as a "bg" drawing so the UI Opacity slider affects it
            -- (turns brighter purple while the player is holding this item)
            t.stroke = make("Square", {
                Filled = false, Thickness = 1, Color = STROKE_COLOR,
                Size = Vector2.new(TILE, TILE), ZIndex = 2, Visible = false,
            }, 0, 0, true)
            pcall(function() t.stroke.d.Corner = 8 end)

            t.img = make("Image", {
                Size = Vector2.new(TILE - IMG_PAD * 2, TILE - IMG_PAD * 2),
                ZIndex = 2, Visible = false,
            }, 0, 0)

            t.label = make("Text", {
                Text = "", Color = GRAY,
                Font = Drawing.Fonts.SystemBold, Size = 10, Center = true,
                ZIndex = 2, Visible = false,
            }, 0, 0)

            -- small attachment icons (bottom-right corner of the tile, stacked upward)
            for k = 1, 4 do
                local sb = make("Square", {
                    Filled = true, Color = BG_COLOR,
                    Size = Vector2.new(SUB_SIZE + 2, SUB_SIZE + 2), ZIndex = 3, Visible = false,
                }, 0, 0, true)
                pcall(function() sb.d.Corner = 4 end)
                local si = make("Image", {
                    Size = Vector2.new(SUB_SIZE, SUB_SIZE),
                    ZIndex = 4, Visible = false,
                }, 0, 0)
                t.subs[k] = { bg = sb, img = si }
            end

            return t
        end

        for i = 1, MAX_TILES do tiles[i] = makeTile() end
        for i = 1, MAX_HOT do hotTiles[i] = makeTile() end

        -- team card: always the LAST block of the stack (only while "View Player Teams" is on)
        rTeamBg = make("Square", {
            Filled = true, Color = BG_COLOR,
            Size = Vector2.new(100, 40), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() rTeamBg.d.Corner = 8 end)
        rTeamHead = make("Text", {
            Text = "", Color = WHITE,
            Font = Drawing.Fonts.SystemBold, Size = 12,
            ZIndex = 2, Visible = false,
        }, 0, 0)
        for i = 1, TEAMS_MAX_ROWS do
            rTeamRows[i] = make("Text", {
                Text = "", Color = GRAY,
                Font = Drawing.Fonts.System, Size = 12,
                ZIndex = 2, Visible = false,
            }, 0, 0)
        end
    end)

    if not hbOK then
        destroyPanel(hbPanel)
        tiles, hotTiles = {}, {}
    end

    ----------------------------------------------------------------------
    -- State + helpers (Visible is only written when it changes; Position only
    -- for the drawings that are in use)
    ----------------------------------------------------------------------
    local shown = false
    local eqCount = 0            -- tiles in the equipment row
    local hotCount = 0           -- tiles in the hotbar-items row (0 = row hidden)
    local tileItem = {}          -- [i] = item currently drawn in equipment tile i
    local tileSub = {}           -- [i] = attachment icon name drawn in equipment tile i
    local hotItem = {}           -- [i] = item currently drawn in hotbar tile i
    local curEquipped = nil      -- name of the tool the targeted player is holding (EquippedTool)
    local titleStr, msgStr = "Hotbar", ""
    local teamOn = false
    local teamHeadStr = ""
    local teamRowStr, teamRowCount = {}, 0

    -- Fade in / out (the panel stays drawn until the fade-out finishes)
    -- (stored as fields on hbPanel instead of locals: this chunk is at Lua's 200-local limit)
    hbPanel.fin = 0.18   -- seconds to fade in
    hbPanel.fout = 0.12  -- seconds to fade out
    hbPanel.fa = 0       -- current fade amount (0 = hidden, 1 = fully shown)
    hbPanel.ft = 0       -- fade target
    hbPanel.fl = nil     -- last frame time
    hbPanel.fade = 0     -- eased value used by applyOpacity

    local function setVis(r, v)
        v = v and true or false
        if r.vis ~= v then
            r.vis = v
            r.d.Visible = v
        end
    end

    local function put(r)
        r.d.Position = Vector2.new(hbPanel.x + r.ox, hbPanel.y + r.oy)
    end

    local function setRowVisible(list, count, s)
        for i = 1, #list do
            local t = list[i]
            local on = s and i <= count
            setVis(t.bg, on)
            setVis(t.stroke, on)
            setVis(t.img, on and t.hasImg)
            setVis(t.label, on and not t.hasImg)
            for k = 1, #t.subs do
                local sv = on and k <= t.nsub
                setVis(t.subs[k].bg, sv)
                setVis(t.subs[k].img, sv)
            end
        end
    end

    local function putRow(list, count)
        for i = 1, count do
            local t = list[i]
            put(t.bg)
            put(t.stroke)
            if t.hasImg then put(t.img) else put(t.label) end
            for k = 1, t.nsub do put(t.subs[k].bg); put(t.subs[k].img) end
        end
    end

    local function applyVisibility()
        local s = shown or hbPanel.fa > 0 -- stays drawn while it fades out
        local noGear = s and eqCount == 0
        setVis(rPill, s)
        setVis(rTitle, s)
        setVis(rMsgBg, noGear)
        setVis(rMsg, noGear)
        setRowVisible(hotTiles, hotCount, s)
        setRowVisible(tiles, eqCount, s)
        local tv = s and teamOn
        setVis(rTeamBg, tv)
        setVis(rTeamHead, tv)
        for i = 1, TEAMS_MAX_ROWS do
            setVis(rTeamRows[i], tv and i <= teamRowCount)
        end
    end

    -- Writes Transparency from the fade value (smoothstep ease, like the notification slide).
    -- allItems = false: only drawings that are currently visible are touched.
    function hbPanel.writeFade(allItems)
        local a = hbPanel.fa
        local e = a * a * (3 - 2 * a)
        hbPanel.fade = e
        local bgA, fgA = bgAlpha() * e, fgAlpha() * e
        local items = hbPanel.items
        for i = 1, #items do
            local it = items[i]
            if allItems or it.vis then
                it.d.Transparency = it.bg and bgA or fgA
            end
        end
    end

    function hbPanel.fadeTo(target)
        if target == hbPanel.ft then return end
        hbPanel.ft = target
        -- starting from fully hidden: set everything to invisible BEFORE it is shown (no one-frame flash)
        if target == 1 and hbPanel.fa == 0 then hbPanel.writeFade(true) end
    end

    RunService.RenderStepped:Connect(function()
        guarded(function()
            local a, target = hbPanel.fa, hbPanel.ft
            if a == target then hbPanel.fl = nil return end -- idle: no work

            -- Performance Mode: skip the fade and jump straight to the target
            if Notification.perf then
                hbPanel.fa = target
                hbPanel.fl = nil
                hbPanel.writeFade(true)
                if target == 0 then applyVisibility() end -- fully hidden: actually hide everything
                return
            end

            local now = tick()
            local last = hbPanel.fl
            local dt = last and (now - last) or 0
            hbPanel.fl = now
            if dt > 0.05 then dt = 0.05 end -- lag spike protection

            if target > a then
                a = a + dt / hbPanel.fin
                if a > 1 then a = 1 end
            else
                a = a - dt / hbPanel.fout
                if a < 0 then a = 0 end
            end
            hbPanel.fa = a

            hbPanel.writeFade(a == 1)                -- on completion, also refresh hidden drawings
            if a == 0 then applyVisibility() end     -- fade-out done: actually hide everything
        end)
    end)

    -- Recomputes size + offsets (only called when something changed), keeps the
    -- panel centered on its current middle, then writes the positions in use.
    -- The panel is a vertical stack of blocks, every block centered:
    --   1) name pill
    --   2) hotbar items (ItemBack1/2, Hotbar4-8)  <- only when at least one slot is filled
    --   3) equipment tiles (or a message card)
    --   4) team card  <- always the very last block
    local function layout()
        applyVisibility() -- hide stale stuff first

        local n = eqCount
        local hn = hotCount
        local pillW = #titleStr * 6 + 36   -- same padding left and right of the centered name
        local hotW = (hn > 0) and (hn * TILE + (hn - 1) * GAP) or 0
        local tilesW = (n > 0) and (n * TILE + (n - 1) * GAP) or 0
        local msgW = (n == 0) and (#msgStr * 6.5 + PAD * 2) or 0
        local teamW = 0
        if teamOn then
            teamW = #teamHeadStr * 7
            for i = 1, teamRowCount do
                local w = #teamRowStr[i] * 6.5
                if w > teamW then teamW = w end
            end
            teamW = teamW + CARD_PAD * 2
        end

        local W = pillW
        if hotW > W then W = hotW end
        if tilesW > W then W = tilesW end
        if msgW > W then W = msgW end
        if teamW > W then W = teamW end
        W = math.floor(W)

        if W ~= hbPanel.w then
            hbPanel.x = hbPanel.x + (hbPanel.w - W) / 2
            hbPanel.w = W
        end

        local function cx(w) return math.floor((W - w) / 2) end

        -- places one row of tiles (centered) with its top edge at `top`
        local function placeRow(list, count, top)
            local x0 = cx(count * TILE + (count - 1) * GAP)
            for i = 1, count do
                local t = list[i]
                local x = x0 + (i - 1) * (TILE + GAP)
                t.bg.ox, t.bg.oy = x, top
                t.stroke.ox, t.stroke.oy = x, top
                t.img.ox, t.img.oy = x + IMG_PAD, top + IMG_PAD
                t.label.ox, t.label.oy = x + TILE / 2, top + TILE / 2 - 1   -- Center = true centers on both axes
                -- small attachment icons: bottom-right corner, 3 per column stacked upward,
                -- a 4th icon starts a second column to the left
                for k = 1, #t.subs do
                    local col, row = math.floor((k - 1) / 3), (k - 1) % 3
                    local bx = x + TILE - (SUB_SIZE + 2) - 2 - col * (SUB_SIZE + 3)
                    local by = top + TILE - (SUB_SIZE + 2) - 2 - row * (SUB_SIZE + 3)
                    t.subs[k].bg.ox, t.subs[k].bg.oy = bx, by
                    t.subs[k].img.ox, t.subs[k].img.oy = bx + 1, by + 1
                end
            end
        end

        -- 1) name pill
        local pillX = cx(pillW)
        rPill.ox, rPill.oy = pillX, 0
        rPill.d.Size = Vector2.new(pillW, PILL_H)
        -- Center = true centers the text on BOTH axes (x and y are its middle point), so y is the pill's middle
        rTitle.ox, rTitle.oy = pillX + pillW / 2 + TITLE_NUDGE_X, PILL_H / 2 - 1
        -- only the pill grabs the mouse for dragging (see dragStep)
        hbPanel.hx, hbPanel.hw = pillX, pillW
        local y = PILL_H + PILL_GAP

        -- 2) hotbar items: only shown when at least one slot has something in it
        if hn > 0 then
            placeRow(hotTiles, hn, y)
            y = y + TILE + SECTION_GAP
        end

        -- 3) equipment tiles, or a small message card when there is nothing to show
        if n > 0 then
            placeRow(tiles, n, y)
            y = y + TILE
        else
            local mx = cx(msgW)
            rMsgBg.ox, rMsgBg.oy = mx, y
            rMsgBg.d.Size = Vector2.new(msgW, 24)
            rMsg.ox, rMsg.oy = mx + PAD, y + 5
            y = y + 24
        end

        -- 4) team card: ALWAYS the last block, under everything else
        if teamOn then
            y = y + SECTION_GAP
            local cardX = cx(teamW)
            local cardH = CARD_PAD * 2 + 14 + ((teamRowCount > 0) and (4 + teamRowCount * 14) or 0)
            rTeamBg.ox, rTeamBg.oy = cardX, y
            rTeamBg.d.Size = Vector2.new(teamW, cardH)
            rTeamHead.ox, rTeamHead.oy = cardX + CARD_PAD, y + CARD_PAD
            for i = 1, teamRowCount do
                rTeamRows[i].ox, rTeamRows[i].oy = cardX + CARD_PAD, y + CARD_PAD + 14 + 4 + (i - 1) * 14
            end
            y = y + cardH
        end

        hbPanel.h = y

        -- positions of the drawings in use
        put(rPill); put(rTitle)
        if n == 0 then put(rMsgBg); put(rMsg) end
        putRow(hotTiles, hn)
        putRow(tiles, n)
        if teamOn then
            put(rTeamBg); put(rTeamHead)
            for i = 1, teamRowCount do put(rTeamRows[i]) end
        end
    end

    local function shortName(name)
        if #name > 9 then return string.sub(name, 1, 7) .. ".." end
        return name
    end

    -- colors + icon of one tile; isEq = the player is holding this item right now;
    -- sub = optional small corner icon (attachment)
    local function styleTile(t, item, isEq, sub)
        t.eq = isEq
        t.bg.d.Color = HIGHLIGHT[item] and HL_TILE or TILE_BG
        t.stroke.d.Color = isEq and EQUIPPED_STROKE or STROKE_COLOR
        t.stroke.d.Thickness = isEq and EQUIPPED_THICKNESS or 1
        local iconsOn = UI.GetValue("opt_icons_off") ~= true
        if iconsOn and imgState[item] == "ok" then
            t.img.d.Data = imgData[item]
            t.hasImg = true
        else
            t.hasImg = false
            t.label.d.Text = shortName(item)
        end
        -- sub = comma separated icon names ("RK2,PEQ15"), or a single name, or nil
        t.subKey = sub or ""
        local ns = 0
        if sub and sub ~= "" then
            for nm in string.gmatch(sub, "[^,]+") do
                if ns >= #t.subs then break end
                if iconsOn and imgState[nm] == "ok" then
                    ns = ns + 1
                    t.subs[ns].img.d.Data = imgData[nm]
                end
            end
        end
        t.nsub = ns
    end

    local function applyTile(i, item, sub)
        tileItem[i] = item
        tileSub[i] = sub
        styleTile(tiles[i], item, curEquipped ~= nil and item == curEquipped, sub)
    end

    ----------------------------------------------------------------------
    -- Reading the equipment
    ----------------------------------------------------------------------
    local function hasAll(atts, names)
        for i = 1, #names do
            if not atts:FindFirstChild(names[i]) then return false end
        end
        return true
    end

    -- Looks up every name from ARMOR_ORDER directly under Inventory (no descendant scan).
    -- out[i] = icon/display name (FastMT may become GMT), subOut[i] = small corner icon or nil
    -- Returns found, n.
    local function readEquipment(name, out, subOut)
        local folder = getPlayersFolder()
        local inv = folder and folder:FindFirstChild(name)
        inv = inv and inv:FindFirstChild("Inventory")
        if not inv then return false, 0 end

        local n = 0
        for i = 1, #ARMOR_ORDER do
            if n >= MAX_TILES then break end
            local gear = ARMOR_ORDER[i]
            local inst = inv:FindFirstChild(gear)
            if inst then
                local shownName, sub = gear, nil
                local atts = inst:FindFirstChild("Attachments")
                if atts then
                    if gear == "FastMT" then
                        if hasAll(atts, ATT.fastmt) then shownName = "GMT" end
                    else
                        local visors = ATT.visors[gear]
                        if visors then
                            for v = 1, #visors do
                                if atts:FindFirstChild(visors[v]) then
                                    sub = visors[v]
                                    break
                                end
                            end
                        end
                    end
                end

                local dup = false -- e.g. a real GMT next to a FastMT shown as GMT
                for k = 1, n do
                    if out[k] == shownName then dup = true break end
                end
                if not dup then
                    n = n + 1
                    out[n] = shownName
                    subOut[n] = sub
                end
            end
        end
        return true, n
    end

    ----------------------------------------------------------------------
    -- TEAMS: ReplicatedStorage.Clans.<leader>'s team.<member>
    -- Every child of Clans is a team folder; the players inside it (anywhere below
    -- the folder) are its members. A name only counts as a member when it matches a
    -- player that is in game.Players, so stray values inside the folders are never
    -- counted. The leader (taken from the folder name "<leader>'s team") counts as a
    -- member too, even if they are not listed inside the folder.
    ----------------------------------------------------------------------
    local clansFolder

    local function getClansFolder()
        if not clansFolder or clansFolder.Parent == nil then
            clansFolder = ReplicatedStorage:FindFirstChild("Clans")
        end
        return clansFolder
    end

    -- Returns the team folder name and the sorted list of member names for `name`,
    -- or nil if they are in no team
    local function findTeam(name)
        local clans = getClansFolder()
        if not clans then return nil end

        local teams = clans:GetChildren()
        for i = 1, #teams do
            local team = teams[i]
            local leader = string.match(team.Name, "^(.+)'s [Tt]eam$")
            local desc = team:GetDescendants()
            local limit = #desc
            if limit > TEAMS_MAX_NODES then limit = TEAMS_MAX_NODES end

            local seen, members = {}, {}
            local inTeam = (leader == name)
            if leader and Players:FindFirstChild(leader) then
                seen[leader] = true
                members[1] = leader
            end
            for j = 1, limit do
                local n = desc[j].Name
                if n == name then inTeam = true end
                if not seen[n] and Players:FindFirstChild(n) then
                    seen[n] = true
                    members[#members + 1] = n
                end
            end

            if inTeam then
                table.sort(members)
                return team.Name, members
            end
        end
        return nil
    end

    -- Returns the team line and the member-name rows for `name`
    local function teamInfo(name)
        if not getClansFolder() then return "Team: unknown", {} end
        local teamName, members = findTeam(name)
        if not teamName then return "Team: none", {} end

        local count = #members
        local header = "Team: " .. teamName .. "  -  " .. count .. (count == 1 and " member" or " members")

        -- pack the names into rows of about TEAMS_LINE_CHARS characters
        local rows, rowNames = {}, {}
        local line, lineCount = "", 0
        for i = 1, count do
            local nm = members[i]
            local candidate = (line == "") and nm or (line .. ", " .. nm)
            if line ~= "" and #candidate > TEAMS_LINE_CHARS then
                rows[#rows + 1] = line
                rowNames[#rowNames + 1] = lineCount
                line, lineCount = nm, 1
            else
                line, lineCount = candidate, lineCount + 1
            end
        end
        if line ~= "" then
            rows[#rows + 1] = line
            rowNames[#rowNames + 1] = lineCount
        end

        -- more names than rows: keep the first rows and say how many are left out
        if #rows > TEAMS_MAX_ROWS then
            local shownNames = 0
            for i = 1, TEAMS_MAX_ROWS - 1 do shownNames = shownNames + rowNames[i] end
            for i = #rows, TEAMS_MAX_ROWS, -1 do rows[i] = nil end
            rows[TEAMS_MAX_ROWS] = "+" .. (count - shownNames) .. " more"
        end
        return header, rows
    end

    ----------------------------------------------------------------------
    -- Called from infoStep (every INFO_SELECT_EVERY seconds)
    ----------------------------------------------------------------------
    ----------------------------------------------------------------------
    -- HOTBAR + EQUIPPED TOOL
    --   ReplicatedStorage.Players.<name>.Status.GameplayVariables.Hotbar.<slot>
    --   ReplicatedStorage.Players.<name>.Status.GameplayVariables.EquippedTool
    -- A slot / the tool can be stored as a String/Object value, as an attribute, or as an
    -- item sitting inside the slot; all of those are understood (use "Hotbar Debug" to see
    -- what the game really uses). Empty / missing slots are skipped.
    ----------------------------------------------------------------------
    -- turns a stored value (string, or an instance such as an ObjectValue target) into an item name
    -- (an EMPTY ObjectValue gives the placeholder name "Unreadable_name": that counts as empty)
    local function nameOf(v)
        if v == nil then return nil end
        if type(v) == "string" then
            if v == "" or v == "Unreadable_name" then return nil end
            return v
        end
        if type(v) == "number" or type(v) == "boolean" then return nil end
        local ok, nm = pcall(function() return v.Name end)
        if ok and type(nm) == "string" and nm ~= "" and nm ~= "Unreadable_name" then return nm end
        return nil
    end

    -- FindFirstChild that ignores capitalisation (the slots are called Itemback1 / ItemBack1 ...)
    local function findCI(parent, name)
        local c = parent:FindFirstChild(name)
        if c then return c end
        local lower = string.lower(name)
        local kids = parent:GetChildren()
        for i = 1, #kids do
            if string.lower(kids[i].Name) == lower then return kids[i] end
        end
        return nil
    end

    -- item name stored under <parent>.<key>, or nil when empty / missing
    local function readItemName(parent, key)
        local n = nameOf(parent:GetAttribute(key))
        if n then return n end
        local c = findCI(parent, key)
        if not c then return nil end
        local okv, v = pcall(function() return c.Value end)
        if okv then
            n = nameOf(v)
            if n then return n end
        end
        local kids = c:GetChildren()
        if #kids > 0 then return kids[1].Name end
        return nil
    end

    local function gameplayVars(name)
        local folder = getPlayersFolder()
        local n = folder and folder:FindFirstChild(name)
        n = n and n:FindFirstChild("Status")
        return n and n:FindFirstChild("GameplayVariables")
    end

    -- Fills out[1..n] with the items in the hotbar slots (slot order, empty slots skipped).
    -- Returns n and the name of the held tool (nil when nothing is equipped).
    local function readHotbar(name, out)
        local gv = gameplayVars(name)
        if not gv then return 0, nil end
        local src = findCI(gv, "Hotbar") or gv
        local n = 0
        for i = 1, #HOT_SLOTS do
            local item = readItemName(src, HOT_SLOTS[i])
            if item then
                n = n + 1
                out[n] = item
            end
        end
        return n, readItemName(gv, "EquippedTool")
    end

    -- An M4 with ALL of Reapir + PEQ15 + Mag556Rnd100 + SOCOM556 under Inventory.M4.Attachments is a GODM4
    -- (icon GODM4.png). Only called when a hotbar slot holds an "M4".
    local function isGodM4(name)
        local folder = getPlayersFolder()
        local m4 = folder and folder:FindFirstChild(name)
        m4 = m4 and m4:FindFirstChild("Inventory")
        m4 = m4 and m4:FindFirstChild("M4")
        local atts = m4 and m4:FindFirstChild("Attachments")
        if not atts then return false end
        return atts:FindFirstChild("Reapir") ~= nil
            and atts:FindFirstChild("PEQ15") ~= nil
            and atts:FindFirstChild("Mag556Rnd100") ~= nil
            and atts:FindFirstChild("SOCOM556") ~= nil
    end

    -- Comma separated list of the ATT.gun attachments found anywhere under Inventory.<gun>.Attachments
    -- (in ATT.gun order, e.g. "RK2,PEQ15"), or nil when there are none.
    local function gunAtts(name, gun)
        local folder = getPlayersFolder()
        local g = folder and folder:FindFirstChild(name)
        g = g and g:FindFirstChild("Inventory")
        g = g and g:FindFirstChild(gun)
        local atts = g and g:FindFirstChild("Attachments")
        if not atts then return nil end
        -- look through everything under Attachments, so nested ones count too
        -- (e.g. Inventory.M4.Attachments.FrontMK12.Attachments.RK2); works for any gun
        local d = atts:GetDescendants()
        local key
        local list = ATT.gun
        for i = 1, #list do
            for j = 1, #d do
                if d[j].Name == list[i] then
                    key = key and (key .. "," .. list[i]) or list[i]
                    break
                end
            end
        end
        return key
    end

    local hotTarget, hotLastRead = nil, 0
    local hotRead = {}

    local curTarget, lastRead = nil, 0
    local teamTarget, teamLastRead = nil, 0
    local eqRead, eqSub = {}, {}

    function hotbarStep(target, now, wantTeams, wantAtt)
        if not hbOK then return end
        local dirty = false

        -- "Disable Icon Loading" flipped: re-apply every tile at once (icons vanish / come back from the
        -- cache, nothing is downloaded again for icons that already loaded)
        local iconsOff = UI.GetValue("opt_icons_off") == true
        if hbPanel.icoOff ~= iconsOff then
            hbPanel.icoOff = iconsOff
            imgDirty = true
        end

        local wantTeamRow = (wantTeams and target ~= nil) and true or false
        if target == nil and hbPanel.fa > 0 then wantTeamRow = teamOn end -- keep the team card while fading out
        if wantTeamRow ~= teamOn then
            teamOn = wantTeamRow
            if teamOn then teamTarget = nil end -- read right away
            dirty = true
        end

        if target then
            if imgDirty then
                imgDirty = false
                for i = 1, MAX_TILES do tileItem[i] = nil; tileSub[i] = nil end -- re-apply tiles with the new icons
                for i = 1, MAX_HOT do hotItem[i] = nil end
                lastRead = 0
                hotLastRead = 0
            end

            if target ~= curTarget or now - lastRead >= EQUIP_REFRESH or hbPanel.att ~= wantAtt then
                curTarget = target
                lastRead = now
                hbPanel.att = wantAtt -- remembers the toggle so flipping it updates right away

                local found, n = readEquipment(target, eqRead, eqSub)

                local title = target
                if title ~= titleStr then
                    titleStr = title
                    rTitle.d.Text = title
                    dirty = true
                end

                local msg = ""
                if not found then
                    msg = "Inventory not found"
                elseif n == 0 then
                    msg = "No equipment found"
                end
                if msg ~= msgStr then
                    msgStr = msg
                    if msg ~= "" then rMsg.d.Text = msg end
                    dirty = true
                end

                if n ~= eqCount then
                    eqCount = n
                    dirty = true
                end
                for i = 1, n do
                    local item, sub = eqRead[i], eqSub[i]
                    if not wantAtt then sub = nil end -- "Attachment Icons" is off: no corner icons
                    if tileItem[i] ~= item or tileSub[i] ~= sub then
                        applyTile(i, item, sub)
                        dirty = true
                    end
                    -- still no icon: (re)request it; retries are throttled by IMG_RETRY
                    if not tiles[i].hasImg then requestImage(item) end
                    if sub then requestImage(sub) end
                end
            end

            -- hotbar slots + equipped tool (fast refresh so weapon swaps show up quickly)
            if target ~= hotTarget or now - hotLastRead >= HOT_REFRESH then
                hotTarget = target
                hotLastRead = now

                local hn, equipped = readHotbar(target, hotRead)
                if hn > MAX_HOT then hn = MAX_HOT end
                curEquipped = equipped

                if hn ~= hotCount then
                    hotCount = hn
                    dirty = true
                end

                local used = false -- only the first tile with the held item gets the "equipped" look
                for i = 1, hn do
                    local raw = hotRead[i]          -- name in the game files
                    local item = raw                -- name / icon shown
                    local key = nil                 -- attachment corner icons
                    if raw == "M4" and isGodM4(target) then
                        item = "GODM4"              -- the GODM4 icon already covers its attachments
                    elseif wantAtt then
                        key = gunAtts(target, raw)
                    end
                    local isEq = false
                    if not used and curEquipped ~= nil and raw == curEquipped then
                        isEq = true
                        used = true
                    end
                    local t = hotTiles[i]
                    if hotItem[i] ~= item or t.eq ~= isEq or t.subKey ~= (key or "") then
                        hotItem[i] = item
                        styleTile(t, item, isEq, key)
                        dirty = true
                    end
                    if not t.hasImg then requestImage(item) end
                    if key then
                        for nm in string.gmatch(key, "[^,]+") do requestImage(nm) end
                    end
                end

                -- the equipment row can show the held item too
                for i = 1, eqCount do
                    local isEq = (curEquipped ~= nil and tileItem[i] == curEquipped)
                    if tiles[i].eq ~= isEq then
                        styleTile(tiles[i], tileItem[i], isEq, tileSub[i])
                        dirty = true
                    end
                end
            end

            if teamOn and (target ~= teamTarget or now - teamLastRead >= TEAMS_REFRESH) then
                teamTarget = target
                teamLastRead = now
                local text, rows = teamInfo(target)
                if text ~= teamHeadStr then
                    teamHeadStr = text
                    rTeamHead.d.Text = text
                end
                for i = 1, #rows do
                    if teamRowStr[i] ~= rows[i] then
                        teamRowStr[i] = rows[i]
                        rTeamRows[i].d.Text = rows[i]
                    end
                end
                teamRowCount = #rows
                dirty = true
            end

            if not shown then
                shown = true
                hbPanel.shown = true
                hbPanel.fadeTo(1)
                dirty = true
            end
        else
            curTarget = nil
            teamTarget = nil
            hotTarget = nil
            curEquipped = nil
            if shown then
                shown = false
                hbPanel.shown = false
                hbPanel.fadeTo(0)
                dirty = true
            end
        end

        if dirty then layout() end
    end

    -- "Hotbar Debug" button: prints what the hotbar sees for the player it is showing
    iconTest = function()
        task.spawn(function()
            -- does this Matcha build have a draw.LoadImage (like some other scripts use)?
            local okD, hasLoad = pcall(function() return draw ~= nil and draw.LoadImage ~= nil end)
            print("[Hotbar debug] draw.LoadImage available: " .. tostring(okD and hasLoad))

            local target = curTarget
            print("[Hotbar debug] target: " .. tostring(target) .. ", tiles in use: " .. eqCount)
            if not target then
                print("[Hotbar debug] no target - look at a player (or use Hotbar Target = Myself), then click again")
                return
            end

            -- GameplayVariables / Hotbar / EquippedTool: what the hotbar row reads
            local okG, errG = pcall(function()
                local gv = gameplayVars(target)
                if not gv then
                    print("[Hotbar debug] no Status.GameplayVariables found for " .. target)
                    return
                end
                local function describe(inst)
                    local okv, v = pcall(function() return inst.Value end)
                    local kids = inst:GetChildren()
                    return inst.Name .. " [" .. inst.ClassName .. "]"
                        .. (okv and (" = " .. tostring(v)) or "")
                        .. ((#kids > 0) and (" (" .. #kids .. " children)") or "")
                end
                local list = gv:GetChildren()
                for i = 1, #list do
                    print("[Hotbar debug] GameplayVariables: " .. describe(list[i]))
                end
                local hb = findCI(gv, "Hotbar")
                if hb then
                    local slots = hb:GetChildren()
                    for i = 1, #slots do
                        print("[Hotbar debug] Hotbar slot: " .. describe(slots[i]))
                    end
                else
                    print("[Hotbar debug] no Hotbar child in GameplayVariables (slots are read from GameplayVariables itself)")
                end
                local hn, eq = readHotbar(target, hotRead)
                local names = {}
                for i = 1, hn do names[#names + 1] = hotRead[i] end
                print("[Hotbar debug] hotbar items read (" .. hn .. "): " .. table.concat(names, ", ")
                    .. " | equipped tool: " .. tostring(eq))
            end)
            if not okG then print("[Hotbar debug] GameplayVariables error: " .. tostring(errG)) end

            local ok, err = pcall(function()
                local folder = getPlayersFolder()
                local inv = folder and folder:FindFirstChild(target)
                inv = inv and inv:FindFirstChild("Inventory")
                if not inv then
                    print("[Hotbar debug] no Inventory found for " .. target)
                    return
                end
                local kids = inv:GetChildren()
                local names = {}
                for i = 1, #kids do names[#names + 1] = kids[i].Name end
                print("[Hotbar debug] Inventory children (" .. #kids .. "): " .. table.concat(names, ", "))

                local d = inv:GetDescendants()
                local limit = #d
                if limit > EQUIP_MAX_NODES then limit = EQUIP_MAX_NODES end
                print("[Hotbar debug] descendants: " .. #d .. ", scanned: " .. limit)
                for i = 1, limit do
                    if ARMOR_INDEX[d[i].Name] then
                        print("[Hotbar debug] gear found at: " .. d[i]:GetFullName())
                    end
                end
            end)
            if not ok then print("[Hotbar debug] scan error: " .. tostring(err)) end

            for i = 1, eqCount do
                local item = tileItem[i]
                if item then
                    print("[Hotbar debug] tile " .. i .. ": " .. item .. " | icon: " .. tostring(imgState[item])
                        .. " | " .. tostring(imgInfo[item]) .. " | drawn as image: " .. tostring(tiles[i].hasImg)
                        .. " | corner icon: " .. tostring(tileSub[i]))
                end
            end

            for i = 1, hotCount do
                local item = hotItem[i]
                if item then
                    print("[Hotbar debug] hotbar tile " .. i .. ": " .. item .. " | icon: " .. tostring(imgState[item])
                        .. " | " .. tostring(imgInfo[item]) .. " | equipped look: " .. tostring(hotTiles[i].eq))
                end
            end

            -- direct download test of the first tile that has no icon yet
            for i = 1, eqCount do
                local item = tileItem[i]
                if item and not tiles[i].hasImg then
                    local url = IMG_BASES[2] .. item .. ".png"
                    print("[Hotbar debug] test download: " .. url)
                    local ok2, data = pcall(fetch, url)
                    if not ok2 then
                        print("[Hotbar debug] request failed: " .. tostring(data))
                    elseif type(data) ~= "string" then
                        print("[Hotbar debug] returned " .. type(data))
                    else
                        print("[Hotbar debug] returned " .. #data .. " bytes, format: " .. tostring(imgKind(data) or "unknown"))
                        if not isPng(data) then
                            print("[Hotbar debug] starts with: " .. (string.gsub(string.sub(data, 1, 60), "[^%w%p ]", "?")))
                        end
                    end
                    break
                end
            end
            print("[Hotbar debug] done")
        end)
    end
end

----------------------------------------------------------------------
-- Shared step: one "looked-at player" pick feeds all panels
----------------------------------------------------------------------
local infoTarget, infoLastRead = nil, 0
local invTarget, invLastRead = nil, 0

local function infoStep()
    local wantInfo = panelOK and UI.GetValue("opt_info")
    local wantInv = invOK and UI.GetValue("opt_inv")
    local wantHotbar = hbOK and UI.GetValue("opt_hotbar")
    local wantTeams = UI.GetValue("opt_teams") == true
    local wantAtt = UI.GetValue("opt_attico") == true
    local hbSelf = UI.GetValue("hotbar_target") == 1

    local needLook = wantInfo or wantInv or (wantHotbar and not hbSelf)
    local target = needLook and findLookedAtPlayer() or nil
    local now = tick()

    -- Player Info (re-read only when the target changes or every INFO_REFRESH seconds)
    if wantInfo and target then
        if target ~= infoTarget or now - infoLastRead >= INFO_REFRESH then
            infoTarget = target
            infoLastRead = now
            local reportsStr, playStr = readPlayerInfo(target)
            updateInfoPanel(target, reportsStr, playStr)
        end
        showInfoPanel(true)
    else
        infoTarget = nil
        showInfoPanel(false)
    end

    -- Inv Aim
    if wantInv and target then
        if target ~= invTarget or now - invLastRead >= INFO_REFRESH then
            invTarget = target
            invLastRead = now
            updateInvPanel(target)
        end
        showInvPanel(true)
    else
        invTarget = nil
        showInvPanel(false)
    end

    -- Hotbar (looked-at player, or yourself)
    if wantHotbar then
        hotbarStep(hbSelf and LOCAL_NAME or target, now, wantTeams, wantAtt)
    else
        hotbarStep(nil, now, false, false)
    end
end

task.spawn(function()
    while true do
        guarded(infoStep)
        wait(INFO_SELECT_EVERY)
    end
end)

-- (own scope: Staff List panel + God Mode detection; shares slOK)
local slOK
do
    ----------------------------------------------------------------------
    -- STAFF LIST PANEL (under the Boss Tracker by default)
    -- Header "Scanning for staff", then only the usernames of players who have a
    -- Early Access flag (EarlyAccessUser on ReplicatedStorage.Players.<name>, with
    -- Status.Purchases.Passes.GivenEarlyAccess as the failsafe).
    -- Matcha has no Players.PlayerAdded / PlayerRemoving events (they are nil), so
    -- game.Players is checked once a second. Only NEW players get their Passes read
    -- (retried for up to SL_MAX_TRIES seconds in case the Passes folder loads a
    -- moment after they join); players who left are dropped from the list.
    -- Other players found with a tag also get a [POSSIBLE MOD] label and a
    -- notification box.
    -- GOD MODE (second failsafe): ReplicatedStorage.Players.<name>.Status.
    -- GameplayVariables.GodMode (BoolValue). It is read for every player in the same
    -- once-a-second scan. While it is on:
    --   * the player is listed as "<name> - God Mode" (orange) in this panel
    --   * their label becomes an orange "God Moded" (instead of [POSSIBLE MOD])
    --   * a red notification box appears when it turns on
    -- The panel is top-anchored (under the Boss Tracker): it grows downward as names are added.
    ----------------------------------------------------------------------
    local STAFF_LIST_INCLUDE_SELF = true -- TEST: lets you see yourself in the list; set to false later
    local SL_MAX_ROWS = 10
    local SL_ROW_H = 16
    local SL_W = 200 -- same width as the Boss Tracker so it lines up under it (and stays clear of Server Loot)
    local SL_MAX_TRIES = 20

    local staffSet = {}      -- [name] = true -> has a staff tag
    local staffChecked = {}  -- [name] = true -> Passes already read for this player
    local staffPending = {}  -- [name] = tries -> waiting for their Passes to exist
    local godSet = {}        -- [name] = true -> GodMode is on right now
    local godSeen = {}       -- [name] = last GodMode state read (true / false), nil = never read
    local godGV = {}         -- [name] = cached Status.GameplayVariables instance
    local staffDirty = true
    local staffWasOn = false

    -- Default spot: directly under the Boss Tracker (same left edge, 10px below its bottom).
    -- The Boss Tracker is 36 + 6 rows * 16 + 6 = 138px tall and starts at y = 20, so this panel
    -- starts at y = 168 and grows DOWNWARD as names are added.
    local slPanel = newPanel("staff", math.floor(Workspace.CurrentCamera.ViewportSize.X - 200 - 20 - 10 - 200), 168, SL_W, 28)
    local slRows, slRowText, slRowGod = {}, {}, {}
    local slBg, slDot, slTitle, slSep, slCount
    local slCountText = ""
    local slVisible = false

    slOK = pcall(function()
        slBg = addItem(slPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(22, 22, 28),
            Size = Vector2.new(SL_W, 28), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() slBg.Corner = 8 end)

        slDot = addItem(slPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(130, 110, 255),
            Size = Vector2.new(6, 6), ZIndex = 2, Visible = false,
        }, 12, 12)
        slTitle = addItem(slPanel, "Text", {
            Text = "Scanning for staff", Color = Color3.fromRGB(255, 255, 255),
            Font = Drawing.Fonts.SystemBold, Size = 12,
            ZIndex = 2, Visible = false,
        }, 24, 8)
        slCount = addItem(slPanel, "Text", {
            Text = "", Color = Color3.fromRGB(255, 90, 90),
            Font = Drawing.Fonts.SystemBold, Size = 13,
            ZIndex = 2, Visible = false,
        }, 12, 30)
        slSep = addItem(slPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(80, 80, 92),
            Size = Vector2.new(SL_W - 24, 1), ZIndex = 2, Visible = false,
        }, 12, 50)
        for i = 1, SL_MAX_ROWS do
            slRows[i] = addItem(slPanel, "Text", {
                Text = "", Color = Color3.fromRGB(190, 190, 200),
                Font = Drawing.Fonts.System, Size = 13,
                ZIndex = 2, Visible = false,
            }, 12, 58 + (i - 1) * SL_ROW_H)
        end
    end)

    if not slOK then
        destroyPanel(slPanel)
        slRows = {}
    end

    -- Panel height follows the number of names; positions are only rewritten when the list changes.
    local function layoutStaffPanel(n, total)
        -- title row, then (only when staff is detected) "Staff Detected (x)", separator and names
        local H = (n > 0) and (58 + n * SL_ROW_H + 6) or 28
        slPanel.h = H
        slBg.Size = Vector2.new(SL_W, H)

        if n > 0 then
            local text = "Staff Detected (" .. total .. ")"
            if text ~= slCountText then
                slCountText = text
                slCount.Text = text
            end
        end
        slCount.Visible = n > 0
        slSep.Visible = n > 0

        for i = 1, SL_MAX_ROWS do
            slRows[i].Visible = (i <= n)
        end

        placePanel(slPanel) -- top edge stays put, so the panel grows downward
    end

    local function renderStaffPanel()
        -- everyone with a staff tag OR GodMode on (a god-moded player may have no tag)
        local names = {}
        for name in pairs(staffSet) do
            names[#names + 1] = name
        end
        for name in pairs(godSet) do
            if not staffSet[name] then names[#names + 1] = name end
        end
        table.sort(names)

        local total = #names
        local n = (total < SL_MAX_ROWS) and total or SL_MAX_ROWS
        for i = 1, n do
            local nm = names[i]
            local god = godSet[nm] == true
            local text = god and (nm .. " - God Mode") or nm
            if total > SL_MAX_ROWS and i == SL_MAX_ROWS then
                text = "+" .. (total - SL_MAX_ROWS + 1) .. " more"
                god = false
            end
            if slRowText[i] ~= text then
                slRowText[i] = text
                slRows[i].Text = text
            end
            if slRowGod[i] ~= god then
                slRowGod[i] = god
                slRows[i].Color = god and GOD_COLOR or Color3.fromRGB(190, 190, 200)
            end
        end
        layoutStaffPanel(n, total)
    end

    local function setStaffPanelVisible(v)
        if v == slVisible then return end
        slVisible = v
        slPanel.shown = v
        slBg.Visible = v
        slDot.Visible = v
        slTitle.Visible = v
        if not v then
            slCount.Visible = false
            slSep.Visible = false
            for i = 1, SL_MAX_ROWS do slRows[i].Visible = false end
        else
            staffDirty = true -- redraw rows when the panel is shown again
        end
    end

    -- Decides which label a player gets: GodMode wins over the Early Access tag.
    -- (You never get a label over yourself.)
    local function refreshLabel(name)
        if name == LOCAL_NAME then return end
        if godSet[name] then
            modTargets[name] = "god"
        elseif staffSet[name] then
            modTargets[name] = true
        else
            modTargets[name] = nil
        end
    end

    -- Reads GodMode for one player (called once a second from syncStaff).
    -- ReplicatedStorage.Players.<name>.Status.GameplayVariables is cached per player
    -- and only looked up again when it is missing / was replaced.
    local function checkGod(name)
        local gv = godGV[name]
        if not gv or gv.Parent == nil then
            local folder = getPlayersFolder()
            local n = folder and folder:FindFirstChild(name)
            n = n and n:FindFirstChild("Status")
            gv = n and n:FindFirstChild("GameplayVariables")
            godGV[name] = gv -- nil = not loaded yet, tried again next scan
        end

        local on = (gv ~= nil) and readFlag(gv, "GodMode")
        local was = godSeen[name]
        godSeen[name] = on
        local isMe = (name == LOCAL_NAME)

        if on then
            if not isMe or STAFF_LIST_INCLUDE_SELF then
                if not godSet[name] then
                    godSet[name] = true
                    staffDirty = true
                    refreshLabel(name)
                end
            end
            -- red box when GodMode turns on (or when it is already on the first time we see the player)
            if not isMe and was ~= true then
                Notification.push("God Mode Detector", name .. " is God Moded", STAFF_NOTIFY)
            end
        elseif godSet[name] then
            godSet[name] = nil
            staffDirty = true
            refreshLabel(name)
        end
    end

    -- Reads Passes for players that are still waiting for them
    local function processStaffPending()
        if next(staffPending) == nil then return end
        local folder = getPlayersFolder()
        if not folder then return end

        for name, tries in pairs(staffPending) do
            local plrFolder = folder:FindFirstChild(name)
            local passes = plrFolder and getPasses(folder, name)
            local isMe = (name == LOCAL_NAME)

            if plrFolder and isEarlyAccess(plrFolder, passes) then
                staffPending[name] = nil
                staffChecked[name] = true
                if not isMe or STAFF_LIST_INCLUDE_SELF then
                    staffSet[name] = true
                    staffDirty = true
                    if not isMe then
                        refreshLabel(name) -- [POSSIBLE MOD] label (or "God Moded" if GodMode is on)
                        Notification.push("Staff Detector", name .. " has " .. STAFF_LABEL, STAFF_NOTIFY)
                    end
                end
            elseif passes then
                -- player folder and Passes both loaded and neither flag is on: not staff
                staffPending[name] = nil
                staffChecked[name] = true
            elseif tries >= SL_MAX_TRIES then
                staffPending[name] = nil
                staffChecked[name] = true -- gave up; checked again the next time they join
            else
                staffPending[name] = tries + 1
            end
        end
    end

    -- Scans game.Players: queues players we have not checked yet, reads GodMode for
    -- everyone, drops ones that are gone
    local function syncStaff()
        local present = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local name = plr.Name
            present[name] = true
            if not staffChecked[name] and staffPending[name] == nil then
                staffPending[name] = 0
            end
            checkGod(name)
        end

        for name in pairs(staffChecked) do
            if not present[name] then
                staffChecked[name] = nil
                if staffSet[name] then
                    staffSet[name] = nil
                    staffDirty = true
                end
                modTargets[name] = nil
            end
        end
        for name in pairs(staffPending) do
            if not present[name] then staffPending[name] = nil end
        end
        for name in pairs(godSeen) do
            if not present[name] then
                godSeen[name] = nil
                godGV[name] = nil
                if godSet[name] then
                    godSet[name] = nil
                    staffDirty = true
                end
                modTargets[name] = nil
            end
        end

        processStaffPending()
    end

    -- Worker (once a second while the list is on): picks up joins/leaves, retries
    -- pending players, and redraws only when something changed
    local function staffStep()
        local on = slOK and UI.GetValue("opt_stafflist")
        if on then
            syncStaff()
            setStaffPanelVisible(true)
            if staffDirty then
                staffDirty = false
                renderStaffPanel()
            end
        else
            if staffWasOn then
                -- turned off: reset everything so a fresh scan runs when it is turned back on
                staffSet, staffChecked, staffPending, modTargets = {}, {}, {}, {}
                godSet, godSeen, godGV = {}, {}, {}
            end
            setStaffPanelVisible(false)
        end
        staffWasOn = on and true or false
    end

    task.spawn(function()
        while true do
            guarded(staffStep)
            wait(1)
        end
    end)
end

-- (own scope: Server Loot panel; shares lootOK)
local lootOK
do
    ----------------------------------------------------------------------
    -- SERVER LOOT SCANNER PANEL (right side by default)
    -- Every LOOT_REFRESH seconds: takes the players still in game.Players, keeps the
    -- ones that also exist in ReplicatedStorage.Players, and counts every item from
    -- LOOT_ITEMS anywhere inside their Inventory (also when it sits inside clothing,
    -- bags or other items). Only players that have at least one of the items are
    -- listed:
    --   PlayerName
    --     R700
    --     338AP (32x)
    -- "(Nx)" is only written when a player has more than one of that item.
    -- Each inventory object with a matching name counts as one.
    ----------------------------------------------------------------------
    local LOOT_W = 200
    local LOOT_ROW_H = 14
    local LOOT_ROW_Y = 28

    local LOOT_SET = {} -- [itemName] = position in LOOT_ITEMS
    for i = 1, #LOOT_ITEMS do
        LOOT_SET[LOOT_ITEMS[i]] = i
    end

    local lootView = Workspace.CurrentCamera.ViewportSize
    local lootPanel = newPanel("loot", math.floor(lootView.X - LOOT_W - 20), 20, LOOT_W, 36)
    local lootStatic = {}       -- bg, dot, title
    local lootRows = {}         -- pooled text rows
    local lootRowText, lootRowKind = {}, {}
    local lootRowCount = 0
    local lootVisible = false
    local lootBg, lootTitle
    local lootTitleText = ""
    local lootLastScan = 0

    local LOOT_WHITE = Color3.fromRGB(255, 255, 255)
    local LOOT_GRAY = Color3.fromRGB(190, 190, 200)

    lootOK = pcall(function()
        lootBg = addItem(lootPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(22, 22, 28),
            Size = Vector2.new(LOOT_W, 36), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() lootBg.Corner = 8 end)
        lootStatic[1] = lootBg

        lootStatic[2] = addItem(lootPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(130, 110, 255),
            Size = Vector2.new(6, 6), ZIndex = 2, Visible = false,
        }, 12, 12)
        lootTitle = addItem(lootPanel, "Text", {
            Text = "Server Loot", Color = LOOT_WHITE,
            Font = Drawing.Fonts.SystemBold, Size = 12,
            ZIndex = 2, Visible = false,
        }, 24, 8)
        lootStatic[3] = lootTitle

        for i = 1, LOOT_MAX_ROWS do
            lootRows[i] = addItem(lootPanel, "Text", {
                Text = "", Color = LOOT_GRAY,
                Font = Drawing.Fonts.System, Size = 12,
                ZIndex = 2, Visible = false,
            }, 12, LOOT_ROW_Y + (i - 1) * LOOT_ROW_H)
            lootRowKind[i] = 2 -- 1 = player name row, 2 = item row
        end
    end)

    if not lootOK then
        destroyPanel(lootPanel)
        lootStatic, lootRows = {}, {}
    end

    local function showLoot(visible)
        if visible == lootVisible then return end
        for i = 1, #lootStatic do
            lootStatic[i].Visible = visible
        end
        for i = 1, lootRowCount do
            lootRows[i].Visible = visible
        end
        lootVisible = visible
        lootPanel.shown = visible
    end

    -- Names of players that are still in the server AND exist in ReplicatedStorage.Players
    local function lootGetNames(out)
        local folder = getPlayersFolder()
        if not folder then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            local name = plr.Name
            if (LOOT_INCLUDE_SELF or name ~= LOCAL_NAME) and folder:FindFirstChild(name) then
                out[#out + 1] = name
            end
        end
        table.sort(out)
    end

    -- Counts the LOOT_ITEMS inside one player's Inventory. Returns nil if they have none.
    -- counts[i] = amount of LOOT_ITEMS[i]
    local function lootScanPlayer(name)
        local folder = getPlayersFolder()
        local plr = folder and folder:FindFirstChild(name)
        local inv = plr and plr:FindFirstChild("Inventory")
        if not inv then return nil end

        local desc = inv:GetDescendants()
        local limit = #desc
        if limit > LOOT_MAX_NODES then limit = LOOT_MAX_NODES end

        local counts = {}
        local found = false
        for i = 1, limit do
            local idx = LOOT_SET[desc[i].Name]
            if idx then
                counts[idx] = (counts[idx] or 0) + 1
                found = true
            end
        end
        if found then return counts end
        return nil
    end

    -- results[i] = { name = playerName, counts = { [itemIndex] = amount } }
    local function renderLoot(results)
        local texts, kinds = {}, {}
        for i = 1, #results do
            local r = results[i]
            texts[#texts + 1] = r.name
            kinds[#kinds + 1] = 1
            for idx = 1, #LOOT_ITEMS do
                local c = r.counts[idx]
                if c then
                    if c > 1 then
                        texts[#texts + 1] = "  " .. LOOT_ITEMS[idx] .. " (" .. c .. "x)"
                    else
                        texts[#texts + 1] = "  " .. LOOT_ITEMS[idx]
                    end
                    kinds[#kinds + 1] = HIGHLIGHT[LOOT_ITEMS[idx]] and 3 or 2 -- 3 = highlighted item
                end
            end
        end
        if #texts == 0 then
            texts[1] = "No loot found"
            kinds[1] = 2
        end

        -- keep within the pooled rows
        if #texts > LOOT_MAX_ROWS then
            local extra = #texts - (LOOT_MAX_ROWS - 1)
            for i = #texts, LOOT_MAX_ROWS, -1 do
                texts[i] = nil
                kinds[i] = nil
            end
            texts[LOOT_MAX_ROWS] = "... +" .. extra .. " more"
            kinds[LOOT_MAX_ROWS] = 2
        end

        -- only write what changed
        local n = #texts
        for i = 1, n do
            if lootRowText[i] ~= texts[i] then
                lootRowText[i] = texts[i]
                lootRows[i].Text = texts[i]
            end
            if lootRowKind[i] ~= kinds[i] then
                lootRowKind[i] = kinds[i]
                if kinds[i] == 1 then
                    lootRows[i].Font = Drawing.Fonts.SystemBold
                    lootRows[i].Color = LOOT_WHITE
                elseif kinds[i] == 3 then
                    lootRows[i].Font = Drawing.Fonts.SystemBold
                    lootRows[i].Color = HIGHLIGHT_COLOR
                else
                    lootRows[i].Font = Drawing.Fonts.System
                    lootRows[i].Color = LOOT_GRAY
                end
            end
        end

        if n ~= lootRowCount then
            if lootVisible then
                for i = n + 1, lootRowCount do lootRows[i].Visible = false end
                for i = lootRowCount + 1, n do lootRows[i].Visible = true end
            end
            lootRowCount = n
            lootPanel.h = LOOT_ROW_Y + n * LOOT_ROW_H + 8
            lootBg.Size = Vector2.new(LOOT_W, lootPanel.h)
        end

        local title = "Server Loot (" .. #results .. ")"
        if title ~= lootTitleText then
            lootTitleText = title
            lootTitle.Text = title
        end
    end

    -- The scan yields between players (so a big server never freezes a frame); those
    -- yields happen outside pcall on purpose.
    task.spawn(function()
        while true do
            local on = lootOK and UI.GetValue("opt_four")
            if on then
                showLoot(true)
                local now = tick()
                if now - lootLastScan >= LOOT_REFRESH then
                    lootLastScan = now

                    local names = {}
                    if not pcall(lootGetNames, names) then loadErrors = loadErrors + 1 end

                    local results = {}
                    for i = 1, #names do
                        local ok, counts = pcall(lootScanPlayer, names[i])
                        if not ok then
                            loadErrors = loadErrors + 1
                        elseif counts then
                            results[#results + 1] = { name = names[i], counts = counts }
                        end
                        task.wait()
                    end

                    if UI.GetValue("opt_four") then -- still on after the scan?
                        guarded(function() renderLoot(results) end)
                    end
                end
            else
                showLoot(false)
                lootLastScan = 0 -- scan right away when it is switched back on
            end
            wait(0.5)
        end
    end)
end

-- (own scope: Boss Tracker panel; shares bossOK)
local bossOK
do
    ----------------------------------------------------------------------
    -- BOSS TRACKER PANEL (left of Server Loot by default)
    -- One row per boss in BOSS_NAMES (listed vertically):
    --   available    -> green, bold:   ! BTR !
    --   unavailable  -> darker grey:   BTR
    -- When a boss changes state a notification box pops up (bottom right). The first
    -- scan after switching the toggle on only sets the starting state (no popups).
    -- Controlled by the "Boss Tracker" toggle in the Server Toggles section.
    --
    -- HOW "AVAILABLE" IS DETECTED (best guess - adjust if your game differs):
    --   a boss counts as available while an object with its name exists directly in
    --   Workspace (or directly inside one of the Workspace folders listed in
    --   BOSS_FOLDERS). Names are compared ignoring case, spaces and dashes, so
    --   "MI-24" also matches "MI24". Only that one list is read, every BOSS_REFRESH
    --   seconds, and only while the toggle is on.
    ----------------------------------------------------------------------
    local BOSS_NAMES = { "Whisper", "Death", "Dozer", "Anton", "BTR80", "MI-24" }
    -- extra places to look in, as paths from Workspace written with "/" (a boss counts as available
    -- while an object with its name exists directly inside that folder):
    --   "AiZones/BTR"  ->  Workspace.AiZones.BTR.BTR80
    local BOSS_FOLDERS = { "AiZones/BTR" }
    local BOSS_REFRESH = 3      -- seconds between scans

    local BOSS_W, BOSS_GAP = 200, 10   -- BOSS_GAP = px between this panel and Server Loot
    local BOSS_ROW_Y, BOSS_ROW_H = 36, 16
    local BOSS_H = BOSS_ROW_Y + #BOSS_NAMES * BOSS_ROW_H + 6

    local BOSS_UP_COLOR = Color3.fromRGB(70, 220, 110)
    local BOSS_DOWN_COLOR = Color3.fromRGB(125, 125, 138) -- slightly darker than the normal panel grey
    local BOSS_UP_NOTIFY = { seconds = 15, color = BOSS_UP_COLOR }
    local BOSS_DOWN_NOTIFY = { seconds = 10, color = BOSS_DOWN_COLOR }

    -- lowercase, letters and digits only
    local function norm(s)
        return string.lower((string.gsub(s, "[^%w]", "")))
    end

    local BOSS_KEY = {} -- [normalized name] = index in BOSS_NAMES
    for i = 1, #BOSS_NAMES do
        BOSS_KEY[norm(BOSS_NAMES[i])] = i
    end

    local bossView = Workspace.CurrentCamera.ViewportSize
    -- Server Loot sits at (view.X - 200 - 20); this goes one panel width + gap further left
    local bossPanel = newPanel("boss", math.floor(bossView.X - 200 - 20 - BOSS_GAP - BOSS_W), 20, BOSS_W, BOSS_H)
    local bossRows = {}
    local bossVisible = false

    bossOK = pcall(function()
        local bg = addItem(bossPanel, "Square", {
            Filled = true, Color = Color3.fromRGB(22, 22, 28),
            Size = Vector2.new(BOSS_W, BOSS_H), ZIndex = 1, Visible = false,
        }, 0, 0, true)
        pcall(function() bg.Corner = 8 end)

        addItem(bossPanel, "Square", { -- purple dot next to the title
            Filled = true, Color = Color3.fromRGB(130, 110, 255),
            Size = Vector2.new(6, 6), ZIndex = 2, Visible = false,
        }, 12, 12)
        addItem(bossPanel, "Text", {
            Text = "Boss Tracker", Color = Color3.fromRGB(255, 255, 255),
            Font = Drawing.Fonts.SystemBold, Size = 12,
            ZIndex = 2, Visible = false,
        }, 24, 8)
        addItem(bossPanel, "Square", { -- separator line
            Filled = true, Color = Color3.fromRGB(80, 80, 92),
            Size = Vector2.new(BOSS_W - 24, 1), ZIndex = 2, Visible = false,
        }, 12, 27)

        for i = 1, #BOSS_NAMES do
            bossRows[i] = addItem(bossPanel, "Text", {
                Text = BOSS_NAMES[i], Color = BOSS_DOWN_COLOR,
                Font = Drawing.Fonts.System, Size = 13,
                ZIndex = 2, Visible = false,
            }, 12, BOSS_ROW_Y + (i - 1) * BOSS_ROW_H)
        end
    end)

    if not bossOK then
        destroyPanel(bossPanel)
        bossRows = {}
    end

    local found = {}   -- [index] = true while that boss exists (reused every scan)
    local bossUp = {}  -- [index] = last known state (nil = not scanned yet)

    -- Marks every boss that has a direct child of `parent` with its name
    local function scanParent(parent)
        local kids = parent:GetChildren()
        for i = 1, #kids do
            local idx = BOSS_KEY[norm(kids[i].Name)]
            if idx then found[idx] = true end
        end
    end

    local function scanBosses()
        for i = 1, #BOSS_NAMES do found[i] = false end
        scanParent(Workspace)
        for i = 1, #BOSS_FOLDERS do
            local f = Workspace
            for part in string.gmatch(BOSS_FOLDERS[i], "[^/]+") do
                f = f:FindFirstChild(part)
                if f == nil or f.Name == "Unreadable_name" then f = nil break end
            end
            if f then scanParent(f) end
        end
    end

    -- Only called when a boss changes state
    local function applyRow(i, up)
        local r = bossRows[i]
        if up then
            r.Text = "! " .. BOSS_NAMES[i] .. " !"
            r.Color = BOSS_UP_COLOR
            r.Font = Drawing.Fonts.SystemBold
        else
            r.Text = BOSS_NAMES[i]
            r.Color = BOSS_DOWN_COLOR
            r.Font = Drawing.Fonts.System
        end
    end

    local lastScan, hadBaseline = 0, false

    local function bossStep()
        if not bossOK then return end
        local on = UI.GetValue("opt_boss") == true

        if on ~= bossVisible then
            bossVisible = on
            setPanelItemsVisible(bossPanel, on)
        end

        if not on then
            if hadBaseline then
                -- switched off: forget the state so the next scan starts fresh (no popups)
                hadBaseline = false
                lastScan = 0
                for i = 1, #BOSS_NAMES do bossUp[i] = nil end
            end
            return
        end

        local now = tick()
        if now - lastScan < BOSS_REFRESH then return end
        lastScan = now
        hadBaseline = true

        scanBosses()
        for i = 1, #BOSS_NAMES do
            local up = found[i]
            local prev = bossUp[i]
            if prev ~= up then
                bossUp[i] = up
                applyRow(i, up)
                if prev ~= nil then -- a real change, not the first scan
                    if up then
                        Notification.push("Boss Tracker", BOSS_NAMES[i] .. " is now available", BOSS_UP_NOTIFY)
                    else
                        Notification.push("Boss Tracker", BOSS_NAMES[i] .. " is no longer available", BOSS_DOWN_NOTIFY)
                    end
                end
            end
        end
    end

    task.spawn(function()
        while true do
            guarded(bossStep)
            wait(0.5)
        end
    end)
end

----------------------------------------------------------------------
-- UI OPACITY (slider in the Interface section; applied only when it changes)
-- Also feeds the Performance Mode toggle into Notification.perf (checked here
-- every 0.2s so no extra loop is needed; the Hotbar fade and the notification
-- slide both read that flag).
----------------------------------------------------------------------
local function opacityStep()
    Notification.perf = UI.GetValue("opt_perf") == true
    local v = UI.GetValue("ui_opacity")
    if type(v) == "number" and v ~= uiOpacity then
        uiOpacity = v
        applyOpacity()
    end
end

task.spawn(function()
    while true do
        guarded(opacityStep)
        wait(0.2)
    end
end)

----------------------------------------------------------------------
-- DRAGGING
-- Hold the left mouse button on a panel's top bar (DRAG_HEADER_H px) and move.
-- Panels are clamped to the screen. Positions reset on re-execute (or with the
-- "Reset UI Positions" button).
----------------------------------------------------------------------
local dragMouse = Players.LocalPlayer:GetMouse()
local dragPanel, dragOX, dragOY = nil, 0, 0
local dragWasDown = false

local function dragStep()
    if not ismouse1pressed() then
        dragPanel = nil
        dragWasDown = false
        return
    end

    local mx, my = dragMouse.X, dragMouse.Y + MOUSE_Y_OFFSET

    -- grab: only on the frame the button goes down, topmost (last created) panel first
    if not dragWasDown and isrbxactive() then
        for i = #panels, 1, -1 do
            local p = panels[i]
            if p.shown then
                local top = panelTop(p)
                local hx0 = p.x + (p.hx or 0)           -- hotbar: only the name pill grabs
                local hx1 = hx0 + (p.hw or p.w)
                if mx >= hx0 and mx <= hx1 and my >= top and my <= top + DRAG_HEADER_H then
                    dragPanel = p
                    dragOX = mx - p.x
                    dragOY = my - top
                    break
                end
            end
        end
    end
    dragWasDown = true

    local p = dragPanel
    if p then
        local view = Workspace.CurrentCamera.ViewportSize
        local nx = clamp(mx - dragOX, 0, view.X - p.w)
        local ntop = clamp(my - dragOY, 0, view.Y - p.h)
        local ny = p.bottom and (ntop + p.h) or ntop
        if nx ~= p.x or ny ~= p.y then
            p.x, p.y = nx, ny
            placePanel(p)
        end
    end
end

RunService.RenderStepped:Connect(function()
    guarded(dragStep)
end)

----------------------------------------------------------------------
-- DROPPED ITEM ESP (World Toggles)
-- Everything inside Workspace.DroppedItems (also inside its sub-folders) that is on the known
-- item lists (weapons, equipment, rations, meds, stims, valuables) and within the
-- "Range (studs)" slider gets its name + distance drawn at its position.
-- Workspace.DroppedItems holds a HUGE number of objects, so:
--   * it is only scanned once a second (and only while the toggle is on), not every frame
--   * only the nearest ESP_MAX items are kept and drawn (text drawings are pooled)
--   * each frame only those few are projected with WorldToScreen
-- Corpse ESP: a Model in the same folder that is not a listed item but holds a Humanoid is a corpse.
----------------------------------------------------------------------
do
    local ESP_MAX = 60           -- most items drawn at once (the nearest ones)
    local ESP_SCAN_EVERY = 1     -- seconds between scans of Workspace.DroppedItems
    local ESP_SCAN_CAP = 3000    -- safety cap on objects looked at per scan
    local ESP_COLOR = Color3.fromRGB(255, 255, 255)
    local ESP_OUTLINE = Color3.fromRGB(0, 0, 0)
    local ESP_FONT = Drawing.Fonts.ProximaSoftBold  -- try Drawing.Fonts.SystemBold / Monospace / Pixel / Minecraft
    local ESP_FONT_SIZE = 14

    -- Every item keeps ITS OWN label (Text drawing) for as long as it stays in the results, so labels
    -- never swap between items when the list is re-sorted (that swapping was the flicker).
    local entries, entryCount = {}, 0   -- current labels: { part, name, dist, col, d (its Text drawing), addr, ... }
    local byAddr = {}                   -- [instance Address] = entry
    local freeDraw = {}                 -- spare Text drawings, reused instead of creating new ones
    local shownCount = 0                -- how many labels are currently visible
    local originPart = nil              -- your HumanoidRootPart (distances are refreshed from it every frame)
    local lastOrigin = nil              -- your position at the last scan (fallback)

    local espSize = ESP_FONT_SIZE      -- current label size (follows the "Item ESP Text Size" slider)

    local function newText()
        local d = freeDraw[#freeDraw]
        if d then
            freeDraw[#freeDraw] = nil
            return d
        end
        d = Drawing.new("Text")
        d.Font = ESP_FONT
        d.Size = espSize
        d.Center = true
        d.Outline = true                      -- black stroke around the white text
        pcall(function() d.OutlineColor = ESP_OUTLINE end)
        d.Color = ESP_COLOR
        d.Visible = false
        return d
    end

    local function releaseEntry(e)
        if e.vis then e.d.Visible = false end
        e.vis = false
        freeDraw[#freeDraw + 1] = e.d
        e.d = nil
        if e.addr then byAddr[e.addr] = nil end
    end

    local function clearEntries()
        for i = 1, #entries do releaseEntry(entries[i]) end
        entries, entryCount, shownCount = {}, 0, 0
    end

    -- Only items from the known lists (ITEM_LIST_TEXT) are drawn, matched by exact name ignoring
    -- capitalisation. The "Filter <category>" toggles under World Toggles decide which categories are
    -- hidden (same categories as the Inv Aim filters). An item that is in several categories stays
    -- visible while at least one of them is not filtered. Corpses / junk never match the lists.
    local espCats = {}    -- [lowercase item name] = { category, ... }
    for itemName, cats in pairs(ITEM_CATEGORIES) do
        espCats[string.lower(itemName)] = cats
    end
    local espHidden = {}  -- [category] = true while its filter is on (re-read at every scan)

    local function espShown(lowerName)
        local cats = espCats[lowerName]
        if not cats then return false end
        for i = 1, #cats do
            if not espHidden[cats[i]] then return true end
        end
        return false
    end

    -- World Filter Text Colors (Settings section) - Dropped Item ESP only.
    -- Each colour group has its OWN explicit item list (names separated by spaces / commas / lines).
    -- Priority when an item is in several groups: Super Valuable, Valuable, Weapons, Armor.
    local WTC = {
        { cat = "Super Valuable", on = "wtc_super",    col = "wtc_super_col", def = { 1.0, 0.08, 0.58 }, items = [[
            CatToken GoldenTicket R700 FlareGun HSPV IOTV4 TFZ98S PEQ15 SOCOM556 Reapir
            Mag556Rnd100 Mag556Round100 ThermalModule 338AP ]] },
        { cat = "Valuable",       on = "wtc_valuable", col = "wtc_valuable_col", def = { 1.0, 0.84, 0.0 }, items = [[
            GPU Gold50g WhisperPlush InflatedCrown WeddingRing MikeShades EnzoPlush DozerPlush DozerArmor
            AntonPlush GoldenMakarov GoldSkull GoldWatch PortableConsole Rubles SolterStatue SPSh44 JPC ]] },
        { cat = "Weapons",        on = "wtc_weapons",  col = "wtc_weapons_col", def = { 1.0, 0.39, 0.39 }, items = [[
            ADAR15 AKM AKMN AsVal FAL Groza IZh12 IZh81 M4 MK23 Makarov Mosin MP443 MP5SD NagantRevolver
            PKM PPSH41 R700 RPG7 SKS SVD Saiga12 TFZ0 TFZ98S TOZ106 TT33 VZ61
            F1 Fuze M84 RGD5 RGO MON50 PMN2 Snowball ]] },
        { cat = "Armor",          on = "wtc_armor",    col = "wtc_armor_col", def = { 0.39, 0.63, 1.0 }, items = [[
            6B2 6B23 6B27 6B43 6B47 6B5 Altyn AltynVisor ConcealedVest DozerArmor FastMT FastVisor
            HSPV IOTV4 JPC LegArmor Lvl4Plate MaskaVisor MotorcycleHelmet MotorcycleHelmetVisor LowCutVisor
            Pantsir3 SSH68 ScavKingHelmet ScavKingVest Smersh TitanShield UNOHelmet UNOVest ZSh ZShVisor
            Balaclava CamoPants CamoShirt CivilianPants CivilianShirt CombatGloves GhillieHood GhillieLegs
            GhillieTorso GorkaPants GorkaShirt GP5 HandWraps KneePads SewnMask SummerPants SummerShirt
            WastelandPants WastelandShirt SantaHat TankCap Bandoiler SpecopsBackpack WastelandBackpack ]] },
        { cat = "Corpse",         on = "wtc_corpse",   col = "wtc_corpse_col", def = { 0.75, 0.45, 1.0 }, items = "" },
        { cat = "Medicals",       on = "wtc_meds",     col = "wtc_meds_col", def = { 0.30, 0.90, 0.45 }, items = [[
            AI2 AI4 AA2 Bandage WoundDressing Defibrillator Rags ]] },
        { cat = "Stims",          on = "wtc_stims",    col = "wtc_stims_col", def = { 0.20, 0.85, 1.0 }, items = [[
            SerumRed SerumGreen SerumYellow SerumPurple ]] },
    }
    -- built once: WTC[i].set[lowercase item name] = true
    for i = 1, #WTC do
        local set = {}
        for nm in string.gmatch(WTC[i].items, "[^%s,]+") do
            set[string.lower(nm)] = true
        end
        WTC[i].set = set
        WTC[i].items = nil
    end
    local wtcColor = {}   -- [category] = Color3 while that group's custom colour is on (re-read at every scan)

    -- Turns whatever UI.GetValue returned for a colour picker into a Color3 (or nil). It is not known
    -- whether Matcha returns a Color3, a table, or separate r, g, b, a numbers, so all are handled.
    local function toColor(r)
        local v = r[1]
        if typeof(v) == "Color3" then return v end
        local R, G, B
        if type(v) == "number" then
            R, G, B = v, r[2], r[3]
        elseif type(v) == "table" then
            R, G, B = v.R or v.r or v[1], v.G or v.g or v[2], v.B or v.b or v[3]
        end
        if type(R) == "number" and type(G) == "number" and type(B) == "number" then
            if R > 1 or G > 1 or B > 1 then return Color3.fromRGB(R, G, B) end -- 0..255 values
            return Color3.new(R, G, B)                                         -- 0..1 values
        end
        return nil
    end

    local function readWtc()
        for i = 1, #WTC do
            local w = WTC[i]
            local c = nil
            if UI.GetValue(w.on) == true then
                c = toColor({ UI.GetValue(w.col) })
                if not c then c = Color3.new(w.def[1], w.def[2], w.def[3]) end -- could not read the picker: group default
            end
            wtcColor[w.cat] = c
        end
    end

    -- custom colour of an item (nil = use the default white / highlight pink)
    local function pickColor(lowerName)
        for i = 1, #WTC do
            local w = WTC[i]
            local c = wtcColor[w.cat]
            if c and w.set[lowerName] then return c end
        end
        return nil
    end

    local function readEspFilters()
        for i = 1, #CATEGORY_TOGGLES do
            local t = CATEGORY_TOGGLES[i]
            espHidden[t.cat] = UI.GetValue(t.espId) == true
        end
        readWtc()
    end

    -- Finds the part that gives a dropped item its position. Matcha returns an invalid placeholder
    -- (named "Unreadable_name") instead of nil for things that are not there, e.g. Model.PrimaryPart
    -- when it is not set, so every candidate is checked with valid() before it is used.
    local function valid(i)
        return i ~= nil and i.Name ~= "Unreadable_name" and i.Name ~= ""
    end

    -- Matcha's IsA("BasePart") answers true for a Model too, so parts are recognised by ClassName.
    local PART_CLASS = {
        Part = true, MeshPart = true, UnionOperation = true, WedgePart = true,
        CornerWedgePart = true, TrussPart = true, SpawnLocation = true, Seat = true,
    }

    local function findPart(obj, cls)
        if PART_CLASS[cls] then return obj end

        -- 1) DroppedItems.<item>.Part
        local p = obj:FindFirstChild("Part")
        if valid(p) and PART_CLASS[p.ClassName] then return p end

        -- 2) any part directly inside the item
        local kids = obj:GetChildren()
        for i = 1, #kids do
            if PART_CLASS[kids[i].ClassName] then return kids[i] end
        end

        -- 3) one level deeper (e.g. an inner Model holding the MeshPart)
        for i = 1, #kids do
            if kids[i].ClassName == "Model" then
                local sub = kids[i]:GetChildren()
                for j = 1, #sub do
                    if PART_CLASS[sub[j].ClassName] then return sub[j] end
                end
            end
        end

        -- 4) the model's PrimaryPart, last (may be an invalid placeholder)
        if cls == "Model" then
            p = obj.PrimaryPart
            if valid(p) and PART_CLASS[p.ClassName] then return p end
        end
        return nil
    end

    -- Where distances are measured from: your character first, then the camera (the camera's
    -- CFrame.Position came back nil in Matcha, which broke the distance maths). Returns the point
    -- and the name of the source it came from.
    local function getOrigin()
        local pos
        pcall(function()
            local char = Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            pos = hrp and hrp.Position
        end)
        if pos then return pos, "HumanoidRootPart" end
        pcall(function() pos = Workspace.CurrentCamera.Position end)
        if pos then return pos, "Camera.Position" end
        pcall(function() pos = Workspace.CurrentCamera.CFrame.Position end)
        if pos then return pos, "Camera.CFrame.Position" end
        return nil, "none"
    end

    -- Corpse detection helpers (kept in one table to save local variables).
    local CP = { no = {}, scan = 0, recheck = 10 }
    -- true when the object has a Humanoid child (matched by class or by name; GetChildren is used
    -- because it is known to work in Matcha)
    CP.hasHum = function(obj)
        local kids = obj:GetChildren()
        for i = 1, #kids do
            local k = kids[i]
            if k.ClassName == "Humanoid" or k.Name == "Humanoid" then return true end
        end
        return false
    end

    -- Dropped objects can sit directly in the folder or inside sub-folders of it (like the example
    -- script handles), so folders are walked into (max 2 levels). Models give their position through
    -- PrimaryPart / first BasePart; a loose part uses its own position.
    local function collect(parent, depth, found, origin, range, state)
        local kids = parent:GetChildren()
        for i = 1, #kids do
            if state.n >= ESP_SCAN_CAP then return end
            state.n = state.n + 1
            local obj = kids[i]
            local cls = obj.ClassName
            if state.items and espShown(string.lower(obj.Name)) then
                -- the item itself (whatever class it is, e.g. DroppedItems.Pantsir3 with a child "Part")
                local part = findPart(obj, cls)
                local pp = part and part.Position
                if pp then
                    local dist = (pp - origin).Magnitude
                    if dist <= range then
                        found[#found + 1] = { part = part, name = obj.Name, dist = dist,
                            col = pickColor(string.lower(obj.Name)), addr = obj.Address }
                    end
                end
            elseif cls == "Folder" then
                if depth < 2 then collect(obj, depth + 1, found, origin, range, state) end
            elseif state.corpses and cls == "Model" then
                -- a Model that is not a listed item but contains a Humanoid is a corpse. Models
                -- without one are remembered for CP.recheck scans so the (huge) pile of junk is not
                -- re-inspected every second.
                local addr = obj.Address
                local lastNo = addr and CP.no[addr]
                if not (lastNo and state.scan - lastNo < CP.recheck) then
                    if CP.hasHum(obj) then
                        local part = findPart(obj, cls)
                        local pp = part and part.Position
                        if pp then
                            local dist = (pp - origin).Magnitude
                            if dist <= state.crange then
                                state.corpses[#state.corpses + 1] = { part = part, name = "[Corpse] " .. obj.Name,
                                    dist = dist, col = wtcColor["Corpse"], addr = addr, corpse = true }
                            end
                        end
                    elseif addr then
                        CP.no[addr] = state.scan
                    end
                end
            end
        end
    end

    -- The ESP is active while its toggle is ON and its keybind is active. A keybind has its own state
    -- (UI.GetValue does not return it), read from the widget: with no key assigned (0) the toggle alone
    -- decides; with a key assigned, the key's mode (toggle / hold / always / click) decides.
    local function kbCheck() -- (a named function: pcall(kbCheck) allocates nothing, this runs every frame)
        local kb = Notification.kbDrop
        local key = kb:GetKey()
        if key ~= nil and key ~= 0 then return kb:IsEnabled() == true end
        return true
    end

    local function espActive()
        if UI.GetValue("opt_dropesp") ~= true then return false end
        if not Notification.kbDrop then return true end
        local ok, on = pcall(kbCheck)
        if not ok then return true end -- could not read the keybind: the toggle alone decides
        return on
    end

    -- Corpse ESP: toggle "opt_corpseesp" + its own keybind (Notification.kbCorpse), same rules as above
    local function corpseKb()
        local kb = Notification.kbCorpse
        local key = kb:GetKey()
        if key ~= nil and key ~= 0 then return kb:IsEnabled() == true end
        return true
    end

    local function corpseActive()
        if UI.GetValue("opt_corpseesp") ~= true then return false end
        if not Notification.kbCorpse then return true end
        local ok, on = pcall(corpseKb)
        if not ok then return true end
        return on
    end

    local function scanDropped()
        local root = Workspace:FindFirstChild("DroppedItems")
            or Workspace:FindFirstChild("RuntimeItems")
            or Workspace:FindFirstChild("Drops")
        if not root then
            if entryCount > 0 then clearEntries() end
            return
        end

        local origin = getOrigin()
        if not origin then return end -- keep the old labels instead of wiping them
        lastOrigin = origin
        readEspFilters()
        local char = Players.LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        originPart = valid(hrp) and hrp or nil
        local range = UI.GetValue("dropesp_range") or 500

        -- items and corpses are found in the SAME walk of the folder
        local itemOn, corpseOn = espActive(), corpseActive()
        CP.scan = CP.scan + 1
        if CP.scan % 120 == 0 then CP.no = {} end -- forget old "not a corpse" notes now and then
        local found = {}
        local state = { n = 0, items = itemOn, scan = CP.scan }
        if corpseOn then
            state.corpses = {}
            state.crange = UI.GetValue("corpseesp_range") or 500
        end
        collect(root, 1, found, origin, range, state)

        table.sort(found, function(a, b) return a.dist < b.dist end)
        local n = (#found < ESP_MAX) and #found or ESP_MAX
        if state.corpses then
            local cs = state.corpses
            table.sort(cs, function(a, b) return a.dist < b.dist end)
            for i = n + 1, #found do found[i] = nil end -- keep only the nearest ESP_MAX items
            for i = 1, (#cs < ESP_MAX) and #cs or ESP_MAX do
                found[#found + 1] = cs[i]
            end
            n = #found
        end

        -- match the new results to the existing labels by instance Address
        local newList, seen = {}, {}
        for i = 1, n do
            local f = found[i]
            local addr = f.addr
            local e = addr and byAddr[addr]
            if e then
                e.part, e.dist, e.name, e.col = f.part, f.dist, f.name, f.col
                e.colSet = false -- colour settings may have changed: write it again once
                e.gone = 0
            else
                e = f
                e.d = newText()
                e.vis, e.off, e.gone = false, 0, 0
                if addr then byAddr[addr] = e end
            end
            if addr then seen[addr] = true end
            newList[#newList + 1] = e
        end

        -- items missing from the results: kept for one more scan (so a single missed scan does not
        -- make a label blink), then freed
        for i = 1, #entries do
            local e = entries[i]
            if not (e.addr and seen[e.addr]) then
                e.gone = (e.gone or 0) + 1
                if e.gone <= 1 then
                    newList[#newList + 1] = e
                else
                    releaseEntry(e)
                end
            end
        end

        entries = newList -- swapped in one step: the renderer never sees a half-built list
        entryCount = #newList
    end

    -- Smoothness: distances come from your live position EVERY frame, a label is only written to when
    -- its text / colour / visibility actually changed, positions are rounded to whole pixels, and a
    -- label that is briefly unreadable or off screen for 1-2 frames keeps showing at its last spot
    -- instead of blinking.
    local function espRender()
        local itemOn, corpseOn = espActive(), corpseActive()
        if entryCount > 0 and not itemOn and not corpseOn then
            clearEntries() -- turned off (toggle or keybind): hide every label immediately
            return
        end

        -- "Item ESP Text Size" slider: applied to every label (and the spare ones) only when it changes
        local sz = UI.GetValue("dropesp_textsize")
        if type(sz) == "number" and sz ~= espSize then
            espSize = sz
            for i = 1, #entries do entries[i].d.Size = sz end
            for i = 1, #freeDraw do freeDraw[i].Size = sz end
        end

        local n = entryCount
        if n == 0 then return end

        local opos = lastOrigin
        local op = originPart
        if op then
            local pp = op.Position
            if pp then opos = pp end
        end

        local used = 0
        for i = 1, n do
            local e = entries[i]
            local d = e.d
            local show = false

            local part = e.part
            local pp = part and part.Position
            -- a kind that was just switched off stays hidden until the next scan frees its labels
            if pp and (e.corpse and corpseOn or (not e.corpse and itemOn)) then
                local pos, onScreen = WorldToScreen(pp)
                if onScreen then
                    show = true
                    e.off = 0

                    local dist = opos and (pp - opos).Magnitude or e.dist
                    local di = math.floor(dist)
                    if e.di ~= di then
                        e.di = di
                        e.txt = e.name .. " [" .. di .. "]"
                    end
                    if e.shownTxt ~= e.txt then
                        e.shownTxt = e.txt
                        d.Text = e.txt
                    end

                    -- colour is written once per entry: custom type colour, else deep pink for
                    -- highlighted items, else white
                    if not e.colSet then
                        e.colSet = true
                        d.Color = e.col or (HIGHLIGHT[e.name] == true and HIGHLIGHT_COLOR or ESP_COLOR)
                    end

                    d.Position = Vector2.new(math.floor(pos.X + 0.5), math.floor(pos.Y - 7 + 0.5))
                end
            end

            if not show then
                local off = (e.off or 0) + 1
                e.off = off
                if off <= 2 and e.vis then show = true end -- short grace period: keep the last position
            end

            if show then used = used + 1 end
            if e.vis ~= show then
                e.vis = show
                d.Visible = show
            end
        end
        shownCount = used
    end

    -- "Dropped Item Debug (prints)" button (Debug Options). Prints what the ESP sees so it is easy to
    -- find out why an item is not drawn. Stored on the Notification table so it needs no extra local.
    Notification.dropDebug = function()
        local ok, err = pcall(function()
            print("[Drop debug] toggle opt_dropesp = " .. tostring(UI.GetValue("opt_dropesp"))
                .. " | keybind: " .. (function()
                    local kb = Notification.kbDrop
                    if not kb then return "widget not available" end
                    local ok, r = pcall(function() return "key=" .. tostring(kb:GetKey()) .. " mode=" .. tostring(kb:GetType()) .. " active=" .. tostring(kb:IsEnabled()) end)
                    return ok and r or ("error: " .. tostring(r))
                end)()
                .. " | ESP active = " .. tostring(espActive())
                .. " | range = " .. tostring(UI.GetValue("dropesp_range")))

            local root, rootName = nil, "none"
            local names = { "DroppedItems", "RuntimeItems", "Drops" }
            for i = 1, #names do
                local r = Workspace:FindFirstChild(names[i])
                if r then root, rootName = r, names[i] break end
            end
            if not root then
                print("[Drop debug] no DroppedItems / RuntimeItems / Drops folder found in Workspace")
                return
            end
            local kids = root:GetChildren()
            print("[Drop debug] root: Workspace." .. rootName .. " [" .. root.ClassName .. "], direct children: " .. #kids)

            local origin, originSrc = getOrigin()
            readEspFilters()
            do
                local r = { UI.GetValue("wtc_armor_col") }
                local parts = {}
                for i = 1, 4 do parts[i] = typeof(r[i]) .. "=" .. tostring(r[i]) end
                print("[Drop debug] armor colour picker returns: " .. table.concat(parts, ", ")
                    .. " | toggle wtc_armor = " .. tostring(UI.GetValue("wtc_armor")))
                print("[Drop debug] custom colours active (armor/weapons/super/valuable): "
                    .. tostring(wtcColor["Armor"] ~= nil) .. "/" .. tostring(wtcColor["Weapons"] ~= nil) .. "/"
                    .. tostring(wtcColor["Super Valuable"] ~= nil) .. "/" .. tostring(wtcColor["Valuable"] ~= nil))
            end
            print("[Drop debug] distance origin: " .. originSrc .. " = " .. tostring(origin))
            if not origin then
                print("[Drop debug] could not read your position (character and camera both nil)")
                return
            end
            local range = UI.GetValue("dropesp_range") or 500
            readEspFilters()
            local st = { n = 0, folders = 0, matched = 0, inrange = 0, other = 0, samples = {}, skipped = {},
                models = 0, corpses = 0, csamples = {} }

            local function walk(parent, depth)
                local list = parent:GetChildren()
                for i = 1, #list do
                    if st.n >= ESP_SCAN_CAP then return end
                    st.n = st.n + 1
                    local obj = list[i]
                    local cls = obj.ClassName
                    if espShown(string.lower(obj.Name)) then
                        st.matched = st.matched + 1
                        local part = findPart(obj, cls)
                        local info = obj.Name .. " [" .. cls .. "]"
                        local pp = part and part.Position
                        if part and not pp then
                            info = info .. " part=" .. part.Name .. " [" .. part.ClassName .. "] POSITION IS NIL"
                        elseif part then
                            local dist = (pp - origin).Magnitude
                            info = info .. " part=" .. part.Name .. " [" .. part.ClassName .. "] dist=" .. math.floor(dist)
                            if dist <= range then
                                st.inrange = st.inrange + 1
                            else
                                info = info .. " (OUT OF RANGE)"
                            end
                        else
                            info = info .. " NO PART FOUND"
                        end
                        if #st.samples < 12 then st.samples[#st.samples + 1] = info end
                    elseif cls == "Folder" then
                        st.folders = st.folders + 1
                        if depth < 2 then walk(obj, depth + 1) end
                    else
                        st.other = st.other + 1
                        if cls == "Model" and st.models < 400 then
                            st.models = st.models + 1
                            if CP.hasHum(obj) then
                                st.corpses = st.corpses + 1
                                if #st.csamples < 8 then
                                    local part = findPart(obj, cls)
                                    local pp = part and part.Position
                                    st.csamples[#st.csamples + 1] = obj.Name .. (part and (" part=" .. part.Name
                                        .. " [" .. part.ClassName .. "]" .. (pp and (" dist=" .. math.floor((pp - origin).Magnitude)) or " POSITION NIL"))
                                        or " NO PART FOUND")
                                end
                            end
                        end
                        if #st.skipped < 12 then st.skipped[#st.skipped + 1] = obj.Name .. " [" .. cls .. "]" end
                    end
                end
            end
            walk(root, 1)

            print("[Drop debug] visited " .. st.n .. " objects | folders: " .. st.folders
                .. " | on the item lists: " .. st.matched .. " | in range: " .. st.inrange
                .. " | not on the lists: " .. st.other)
            for i = 1, #st.samples do print("[Drop debug] match: " .. st.samples[i]) end
            if st.matched == 0 then
                print("[Drop debug] nothing matched the lists. Examples of what was skipped (name [class]):")
                for i = 1, #st.skipped do print("[Drop debug]   skipped: " .. st.skipped[i]) end
            end
            print("[Drop debug] corpse check: Models inspected = " .. st.models .. " | with a Humanoid (corpses) = " .. st.corpses
                .. " | Corpse ESP active = " .. tostring(corpseActive()) .. " | corpse range = " .. tostring(UI.GetValue("corpseesp_range")))
            for i = 1, #st.csamples do print("[Drop debug] corpse: " .. st.csamples[i]) end
            if st.corpses == 0 and st.models > 0 then
                print("[Drop debug] no Model had a Humanoid child; if corpses look different (e.g. no Humanoid), send me the corpse's children")
            end
            print("[Drop debug] ESP state: scanned entries = " .. entryCount .. ", drawn on screen = " .. shownCount)
            if entryCount > 0 then
                local e = entries[1]
                local pos, on = WorldToScreen(e.part.Position)
                print("[Drop debug] nearest entry: " .. e.name .. " dist=" .. math.floor(e.dist)
                    .. " screen=(" .. math.floor(pos.X) .. ", " .. math.floor(pos.Y) .. ") onScreen=" .. tostring(on))
            end
            print("[Drop debug] done")
        end)
        if not ok then print("[Drop debug] error: " .. tostring(err)) end
    end

    RunService.RenderStepped:Connect(function()
        guarded(espRender)
    end)

    local wasActive, lastScanAt = false, 0
    task.spawn(function()
        while true do
            local active = espActive() or corpseActive()
            if active then
                local now = tick()
                if not wasActive or now - lastScanAt >= ESP_SCAN_EVERY then
                    lastScanAt = now
                    guarded(scanDropped)
                end
            elseif entryCount > 0 then
                clearEntries() -- off: hide and free every label
            end
            wasActive = active
            wait(0.1)
        end
    end)
end

